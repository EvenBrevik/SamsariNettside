---
import Base from '../../../layouts/Base.astro';
import BlogOverview from '../../../components/BlogOverview.astro';
import { getAllPosts } from '../../../lib/posts';
import { breadcrumbSchema, caseListSchema } from '../../../data/schema';
import { site } from '../../../data/site';
import { LOCALES, DEFAULT_LOCALE, isLocale, localizePath } from '../../../i18n/config';
import { useTranslations } from '../../../i18n/utils';

export function getStaticPaths() {
  return LOCALES.filter((locale) => locale !== DEFAULT_LOCALE).map((locale) => ({
    params: { locale },
  }));
}

const { locale: param } = Astro.params;
const locale = param && isLocale(param) ? param : DEFAULT_LOCALE;
const t = useTranslations(locale);
const posts = await getAllPosts(locale);

const overviewUrl = new URL(localizePath('/blogg', locale), site.url).href;

const listed = posts
  .filter((post) => post.slug)
  .map((post) => ({
    name: post.title,
    url: new URL(localizePath(`/blogg/${post.slug}`, locale), site.url).href,
  }));

const listLd = caseListSchema(listed, t('blog.title'), t('blog.intro'));
const breadcrumbLd = breadcrumbSchema([{ name: t('blog.title'), url: overviewUrl }], t('nav.home'));
---

<Base title={t('blog.title')} description={t('blog.intro')}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(listLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
  </Fragment>

  <BlogOverview />
</Base>
