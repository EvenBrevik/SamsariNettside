---
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import { PUBLIC_CF_ANALYTICS_TOKEN } from 'astro:env/client';
import { organizationSchema } from '../data/schema';
import { LOCALE_META, localeFromPath } from '../i18n/config';
import { useTranslations } from '../i18n/utils';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
  noindex?: boolean;
  availableLocales?: readonly string[];
}

const { title, description, type, image, noindex, availableLocales } = Astro.props;

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
---

<!doctype html>
<html lang={LOCALE_META[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/Favicon_blue_32x32.png" />
    <link rel="apple-touch-icon" href="/Favicon_blue_32x32.png" />
    <meta name="theme-color" content="#1183ce" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo
      title={title}
      description={description}
      type={type}
      image={image}
      noindex={noindex}
      availableLocales={availableLocales}
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema(locale))} />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#innhold" class="skip-link">{t('skip.toContent')}</a>

    <Header />

    <main id="innhold" class="flex-1">
      <slot />
    </main>

    {
      /* Cookieløs besøksstatistikk. Uten token lastes ingen sporing i det hele tatt. */
      PUBLIC_CF_ANALYTICS_TOKEN && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${PUBLIC_CF_ANALYTICS_TOKEN}"}`}
        />
      )
    }
  </body>
</html>
