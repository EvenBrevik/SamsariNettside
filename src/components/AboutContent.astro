---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import portraitOliver from '../assets/portrait-oliver.png';
import portraitEven from '../assets/portrait-even.png';
import portraitAdrian from '../assets/portrait-adrian.jpg';
import placeStavanger from '../assets/place-stavanger.jpg';
import placeKristiansund from '../assets/place-kristiansund.jpg';
import storyLaeretid from '../assets/story-laeretid.jpg';
import storyGreenTechSee from '../assets/story-greentechsee.jpg';
import storyIdag from '../assets/story-idag.jpg';
import valueStartSolution from '../assets/value-start-solution.jpg';
import valueWorkInProgress from '../assets/value-work-in-progress.jpg';
import valueWhiteboard from '../assets/value-whiteboard.jpg';
import valueProductDev from '../assets/value-product-dev.jpg';
import momentHandshake from '../assets/moment-handshake.png';
import aboutHero from '../assets/about-hero.png';
import aboutFinal from '../assets/about-final.png';
import { BOOKING_URL, people } from '../data/site';
import { localeFromPath } from '../i18n/config';
import { useTranslations } from '../i18n/utils';
import type { UIKeys } from '../i18n/ui/nb';

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);

// 2. Historien — tre bilder i scrapbook-oppsett. Det første lenker til
// Sparebank 1 Nordmøres artikkel om at lærlingene startet egen bedrift.
const storyShots = [
  {
    image: storyLaeretid,
    altKey: 'ab.story.img1' as UIKeys,
    capKey: 'ab.story.cap1' as UIKeys,
    linkKey: 'ab.story.link1' as UIKeys,
    href: 'https://www.sparebank1.no/nb/nordmore/om-oss/nyheter/laerlinger-starter-egen-bedrift.html',
  },
  {
    image: storyGreenTechSee,
    altKey: 'ab.story.img2' as UIKeys,
    capKey: 'ab.story.cap2' as UIKeys,
  },
  {
    image: storyIdag,
    altKey: 'ab.story.img3' as UIKeys,
    capKey: 'ab.story.cap3' as UIKeys,
  },
];

// 3. Stedene.
const places = [
  {
    key: 'kristiansund',
    nameKey: 'ab.places.kristiansund.name' as UIKeys,
    bodyKey: 'ab.places.kristiansund.body' as UIKeys,
    altKey: 'ab.places.kristiansund.imageAlt' as UIKeys,
    image: placeKristiansund,
  },
  {
    key: 'stavanger',
    nameKey: 'ab.places.stavanger.name' as UIKeys,
    bodyKey: 'ab.places.stavanger.body' as UIKeys,
    altKey: 'ab.places.stavanger.imageAlt' as UIKeys,
    image: placeStavanger,
  },
];

// 4. Verdiene — vertikalt, med stort nummer i bakgrunnen.
const valueImages = [
  valueStartSolution,
  valueWorkInProgress,
  valueWhiteboard,
  valueProductDev,
];

const values = Array.from({ length: 4 }, (_, i) => ({
  num: String(i + 1).padStart(2, '0'),
  titleKey: `ab.values.v${i + 1}.title` as UIKeys,
  bodyKey: `ab.values.v${i + 1}.body` as UIKeys,
  altKey: `ab.values.v${i + 1}.imageAlt` as UIKeys,
  image: valueImages[i],
}));

// 5. Teamet. LinkedIn-lenkene peker foreløpig til selskapssiden — bytt til
// personlige profiler når vi har dem.
const portraits: Record<string, ImageMetadata> = {
  oliver: portraitOliver,
  even: portraitEven,
  adrian: portraitAdrian,
};

const team = people.map((person) => ({
  ...person,
  nameKey: `ab.team.${person.key}.name` as UIKeys,
  roleKey: (person.key === 'even' ? 'ct.team.even.role' : `ab.team.${person.key}.role`) as UIKeys,
  bodyKey: `ab.team.${person.key}.body` as UIKeys,
  locationKey: (person.key === 'oliver' ? 'ct.places.stavanger.name' : 'ct.places.kristiansund.name') as UIKeys,
  portrait: portraits[person.key],
}));

// 7. Tallene. `count` styrer om tallet skal telles opp — årstall vises statisk,
// og små tall trenger det ikke.
const numbers = [
  { value: '2025', labelKey: 'ab.numbers.founded' as UIKeys, count: false },
  { value: '3', labelKey: 'ab.numbers.people' as UIKeys, count: false },
  { value: '2', labelKey: 'ab.numbers.places' as UIKeys, count: false },
  { value: '3', labelKey: 'ab.numbers.products' as UIKeys, count: false },
];

// Ferdighetslistene er skrevet som «A · B · C» og splittes til chips.
---

<article class="ab">
  <!-- 1. Hero -->
  <section class="ab-hero">
    <div class="ab-hero__inner">
      <div class="ab-hero__copy">
        <h1 class="ab-hero__title">{t('ab.title')}</h1>
        <p class="ab-hero__intro">{t('ab.intro')}</p>
        <p class="ab-hero__facts">{t('ab.facts')}</p>
      </div>

      <figure class="ab-hero__figure">
        <div class="ab-hero__media">
          <Image
            class="ab-hero__photo"
            src={aboutHero}
            alt={t('ab.heroImageAlt')}
            width={1100}
            widths={[560, 800, 1100, 1440]}
            sizes="(min-width: 60rem) 52vw, 92vw"
            format="webp"
            quality={82}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <figcaption class="ab-hero__disclaimer">{t('ab.heroDisclaimer')}</figcaption>
      </figure>
    </div>
  </section>

  <!-- 2. Historien -->
  <section class="ab-story" data-reveal>
    <div class="ab-wrap">
      <div class="story">
        <div class="story__copy">
          <h2 class="ab-head">{t('ab.story.title')}</h2>
          <p class="story__text">{t('ab.story.p1')}</p>
          <p class="story__text">{t('ab.story.p2')}</p>
        </div>

        {/* Scrapbook: tre bilder i ulik størrelse og forskjøvet plassering, slik
            at seksjonen leses som dokumentasjon fra reisen og ikke som et
            symmetrisk galleri. */}
        <div class="story__shots">
          {
            storyShots.map((shot, index) => (
              <figure class:list={['shot', `shot--${index + 1}`]}>
                <div class="shot__media">
                  <Image
                    class="shot__photo"
                    src={shot.image}
                    alt={t(shot.altKey)}
                    width={900}
                    widths={[420, 640, 900, 1200]}
                    sizes="(min-width: 40rem) 46vw, 92vw"
                    format="webp"
                    quality={82}
                    loading="lazy"
                    decoding="async"
                  />
                </div>

                <figcaption>
                  <span class="shot__caption">{t(shot.capKey)}</span>

                  {index === 2 && <span class="shot__disclaimer">{t('ab.heroDisclaimer')}</span>}

                  {shot.href && shot.linkKey && (
                    <a class="shot__link" href={shot.href} target="_blank" rel="noreferrer">
                      {t(shot.linkKey)}
                    </a>
                  )}
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Kristiansund ↔ Stavanger -->
  <section class="ab-places" data-reveal>
    <div class="ab-wrap">
      <h2 class="ab-head ab-head--center">{t('ab.places.title')}</h2>

      <div class="places">
        {
          places.map((place) => (
            <div class="place">
              <div class="place__media">
                <Image
                  class="place__photo"
                  src={place.image}
                  alt={t(place.nameKey)}
                  width={900}
                  widths={[480, 700, 900, 1200]}
                  sizes="(min-width: 48rem) 46vw, 92vw"
                  format="webp"
                  quality={82}
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <h3 class="place__name">{t(place.nameKey)}</h3>
              <p class="place__body">{t(place.bodyKey)}</p>
            </div>
          ))
        }
      </div>

      {/* Linjen mellom stedene tegnes opp når seksjonen kommer i sikte. */}
      <div class="route" aria-hidden="true">
        <span class="route__dot" />
        <svg class="route__line" viewBox="0 0 400 2" preserveAspectRatio="none">
          <line x1="0" y1="1" x2="400" y2="1" stroke="currentColor" stroke-width="2" />
        </svg>
        <span class="route__label">{t('ab.places.distance')}</span>
        <svg class="route__line" viewBox="0 0 400 2" preserveAspectRatio="none">
          <line x1="0" y1="1" x2="400" y2="1" stroke="currentColor" stroke-width="2" />
        </svg>
        <span class="route__dot" />
      </div>
    </div>
  </section>

  <!-- 4. Verdiene -->
  <section class="ab-values" data-reveal>
    <div class="ab-wrap">
      <h2 class="ab-head">{t('ab.values.title')}</h2>

      <ol class="values">
        {
          values.map((value) => (
            <li class="value">
              <span class="value__num" aria-hidden="true">
                {value.num}
              </span>

              <div class="value__copy">
                <h3 class="value__title">{t(value.titleKey)}</h3>
                <p class="value__body">{t(value.bodyKey)}</p>
              </div>

              <div class="value__media">
                <Image
                  class="value__photo"
                  src={value.image}
                  alt={t(value.altKey)}
                  width={720}
                  widths={[400, 560, 720, 960]}
                  sizes="(min-width: 56rem) 30vw, 92vw"
                  format="webp"
                  quality={80}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 5. Teamet -->
  <section class="ab-team" data-reveal>
    <div class="ab-wrap">
      <h2 class="ab-head ab-head--center">{t('ab.team.title')}</h2>

      <ul class="persons">
        {
          team.map((person) => (
            <li class="person">
              <div class="person__media">
                <Image class="person__photo" src={person.portrait} alt={t(person.nameKey)} width={640} widths={[360, 480, 640, 860]} sizes="(min-width: 48rem) 30vw, 92vw" format="webp" quality={82} loading="lazy" decoding="async" />
              </div>

              <div class="person__body">
                <h3 class="person__name">{t(person.nameKey)}</h3>
                <p class="person__role">{t(person.roleKey)}</p>
                <p class="person__location">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
                    <circle cx="12" cy="10" r="2.5" />
                  </svg>
                  {t(person.locationKey)}
                </p>
                <p class="person__text">{t(person.bodyKey)}</p>

                <div class="person__contact">
                  <a href={`mailto:${person.email}`}>{person.email}</a>
                  <a href={person.phoneHref}>{person.phone}</a>
                </div>

                <div class="person__actions">
                  <a class="person__btn" href={`mailto:${person.email}`}>{t('ct.team.emailCta')}</a>
                  <a class="person__btn person__btn--quiet" href={person.phoneHref}>{t('ct.team.phoneCta')}</a>
                  <a class="person__btn person__btn--quiet person__btn--linkedin" href={person.linkedin} target="_blank" rel="noreferrer" aria-label={`LinkedIn – ${t(person.nameKey)}`} title={`LinkedIn – ${t(person.nameKey)}`}>
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4V10h4v1.5A5 5 0 0 1 16 8ZM2 9h4v12H2V9Zm2-7a2 2 0 1 1 0 4 2 2 0 0 1 0-4Z" />
                    </svg>
                  </a>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 6. Arbeidsøyeblikk -->
  <section class="ab-moment" data-reveal>
    <div class="ab-wrap">
      <div class="moment">
        <div class="moment__media">
          <Image
            class="moment__photo"
            src={momentHandshake}
            alt={t('ab.moment.imageAlt')}
            width={1100}
            widths={[560, 800, 1100, 1440]}
            sizes="(min-width: 60rem) 56vw, 92vw"
            format="webp"
            quality={82}
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="moment__copy">
          <h2 class="ab-head">{t('ab.moment.title')}</h2>
          <p class="moment__body">{t('ab.moment.body')}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Tall -->
  <section class="ab-numbers" data-reveal>
    <div class="ab-wrap">
      <ul class="numbers">
        {
          numbers.map((item) => (
            <li class="number">
              <span class="number__value">{item.value}</span>
              <span class="number__label">{t(item.labelKey)}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 8. Avslutning -->
  <section class="ab-final" data-reveal>
    <div class="ab-wrap">
      <div class="final">
        <div class="final__media">
          <div class="final__visual">
            <span class="final__accent" aria-hidden="true"></span>
            <Image
              class="final__photo"
              src={aboutFinal}
              alt={t('ab.final.imageAlt')}
              width={900}
              widths={[480, 700, 900, 1200]}
              sizes="(min-width: 56rem) 44vw, 92vw"
              format="webp"
              quality={82}
              loading="lazy"
              decoding="async"
            />
          </div>
          <p class="final__disclaimer">{t('ab.heroDisclaimer')}</p>
        </div>

        <div class="final__copy">
          <h2 class="final__title">{t('ab.final.title')}</h2>
          <p class="final__body">{t('ab.final.body')}</p>
          <Button href={BOOKING_URL} external>{t('ab.final.cta')}</Button>
        </div>
      </div>
    </div>
  </section>
</article>

<script>
  // Inntoning på scroll, som på de andre sidene. Heroen er utelatt — den
  // animeres ved innlasting i stedet.
  const sections = document.querySelectorAll<HTMLElement>('[data-reveal]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (reduceMotion.matches || !('IntersectionObserver' in window)) {
    for (const section of sections) section.classList.add('is-visible');
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.08, rootMargin: '0px 0px -40px 0px' },
    );

    for (const section of sections) observer.observe(section);
  }
</script>

<style>
  /* --- Felles --- */

  .ab-wrap {
    max-width: 76rem;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  @media (min-width: 40rem) {
    .ab-wrap {
      padding: 0 2rem;
    }
  }

  .ab > section {
    padding: 5rem 0;
  }

  @media (min-width: 48rem) {
    .ab > section {
      padding: 7rem 0;
    }
  }

  .ab-head {
    margin: 0 0 2.5rem;
    color: var(--color-ink);
    font-size: clamp(1.75rem, 3.6vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .ab-head--center {
    max-width: 24ch;
    margin-inline: auto;
    text-align: center;
  }

  /* Felles plassholderflate for alle bildene på siden. */
  .member__frame,
  /* :global fordi <Image> er en egen komponent og ikke får scope-attributtet. */
  .ab-hero__media :global(.ab-hero__photo) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    max-height: 62vh;
    object-fit: cover;
    background: var(--color-canvas);
  }

  .member__frame svg,

  .member__frame span,

  /* --- Inntoning --- */

  [data-reveal] .story__copy,
  [data-reveal] .shot,
  [data-reveal] .ab-head,
  [data-reveal] .place,
  [data-reveal] .value,
  [data-reveal] .person,
  [data-reveal] .moment__media,
  [data-reveal] .moment__copy,
  [data-reveal] .number,
  [data-reveal] .final {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 640ms ease,
      transform 640ms ease;
  }

  [data-reveal].is-visible .story__copy,
  [data-reveal].is-visible .shot,
  [data-reveal].is-visible .ab-head,
  [data-reveal].is-visible .place,
  [data-reveal].is-visible .value,
  [data-reveal].is-visible .person,
  [data-reveal].is-visible .moment__media,
  [data-reveal].is-visible .moment__copy,
  [data-reveal].is-visible .number,
  [data-reveal].is-visible .final {
    opacity: 1;
    transform: translateY(0);
  }

  /* Forskjøvet: elementene vandrer inn etter hverandre, ikke samtidig. */
  [data-reveal].is-visible .shot:nth-child(2),
  [data-reveal].is-visible .place:nth-child(2),
  [data-reveal].is-visible .value:nth-child(2),
  [data-reveal].is-visible .person:nth-child(2),
  [data-reveal].is-visible .number:nth-child(2),
  [data-reveal].is-visible .moment__copy {
    transition-delay: 110ms;
  }

  [data-reveal].is-visible .shot:nth-child(3),
  [data-reveal].is-visible .value:nth-child(3),
  [data-reveal].is-visible .person:nth-child(3),
  [data-reveal].is-visible .number:nth-child(3) {
    transition-delay: 220ms;
  }

  [data-reveal].is-visible .value:nth-child(4),
  [data-reveal].is-visible .number:nth-child(4) {
    transition-delay: 330ms;
  }

  /* --- 1. Hero --- */

  .ab-hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100vh;
    min-height: 100dvh;
    background: var(--color-surface);
    overflow: hidden;
    padding: calc(var(--header-height) + 2rem) 0 2.5rem !important;
  }

  .ab-hero::before {
    content: '';
    position: absolute;
    top: -18rem;
    right: -14rem;
    width: 48rem;
    height: 48rem;
    border-radius: 50%;
    background: radial-gradient(circle, var(--color-brand-soft) 0%, transparent 68%);
    opacity: 0.8;
    pointer-events: none;
  }

  .ab-hero__inner {
    position: relative;
    display: grid;
    gap: 3rem;
    align-items: center;
    width: 100%;
    max-width: 76rem;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  @media (min-width: 40rem) {
    .ab-hero__inner {
      padding: 0 2rem;
    }
  }

  @media (min-width: 60rem) {
    .ab-hero__inner {
      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr);
      gap: clamp(3rem, 6vw, 4.5rem);
    }
  }

  /* Teksten tones inn og løftes ved innlasting — subtilt, som beskrevet. */
  .ab-hero__copy > * {
    opacity: 0;
    transform: translateY(18px);
    animation: hero-in 760ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .ab-hero__copy > *:nth-child(2) {
    animation-delay: 110ms;
  }

  .ab-hero__copy > *:nth-child(3) {
    animation-delay: 220ms;
  }

  @keyframes hero-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .ab-hero__title {
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(2.25rem, 4.8vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .ab-hero__intro {
    max-width: 46ch;
    margin: 1.75rem 0 0;
    color: var(--color-ink-soft);
    font-size: clamp(1rem, 1.5vw, 1.1875rem);
    line-height: 1.75;
  }

  .ab-hero__facts {
    margin: 2.5rem 0 0;
    padding-top: 1.5rem;
    color: var(--color-muted);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  /* Bildet skalerer svakt ned ved innlasting, 1.03 → 1.00. */
  .ab-hero__media {
    overflow: hidden;
    border-radius: 0.5rem 3rem 0.5rem 3rem;
    box-shadow: 0 2px 8px rgb(30 48 58 / 0.06), 0 24px 56px rgb(30 48 58 / 0.14);
    animation: hero-zoom 1100ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .ab-hero__figure {
    min-width: 0;
    margin: 0;
  }

  .ab-hero__disclaimer {
    margin-top: 0.625rem;
    color: var(--color-muted);
    font-size: 0.6875rem;
    line-height: 1.5;
    text-align: right;
  }

  @keyframes hero-zoom {
    from {
      transform: scale(1.03);
    }
    to {
      transform: scale(1);
    }
  }

  .ab-hero__placeholder {
    aspect-ratio: 4 / 3;
    max-height: 62vh;
    border: 0;
  }

  /* --- 2. Historien --- */

  .ab-story {
    background: var(--color-canvas);
  }

  .story {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 60rem) {
    .story {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
      gap: clamp(3rem, 6vw, 5rem);
      align-items: center;
    }
  }

  .story__text {
    max-width: 52ch;
    margin: 0 0 1.25rem;
    color: var(--color-ink-soft);
    font-size: 1.0625rem;
    line-height: 1.8;
  }

  .story__text:last-child {
    margin-bottom: 0;
  }

  /* Scrapbook: bildene ligger i et grid med ulik størrelse og forskyvning. */
  .story__shots {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .shot {
    margin: 0;
  }

  .shot__media {
    overflow: hidden;
    border-radius: 0.5rem 1.75rem 0.5rem 1.75rem;
  }

  /* :global fordi <Image> er en egen komponent og ikke får scope-attributtet.
     Hvert bilde har sitt eget sideforhold — GTS-bildet er stående, de to andre
     liggende — så de får hver sin regel under. */
  .shot__media :global(.shot__photo) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--color-canvas);
  }

  .shot figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 0.875rem;
  }

  .shot__caption {
    display: inline-flex;
    align-items: center;
    color: var(--color-brand);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
