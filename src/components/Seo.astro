---
import { site } from '../data/site';
import {
  LOCALES,
  LOCALE_META,
  DEFAULT_LOCALE,
  localeFromPath,
  stripLocale,
  localizePath,
} from '../i18n/config';
import { SITE_META } from '../i18n/meta';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  image?: string;
  /** Følger med `image`. Utelatt betyr standardformatet 1200×630. */
  imageWidth?: number;
  imageHeight?: number;
  noindex?: boolean;
  /** Overstyrer canonical der en side finnes på flere URL-er. */
  canonical?: string;
  /**
   * Språk siden finnes på. Utelatt betyr «alle» — sett den kun når en side
   * mangler oversettelser, ellers lover hreflang sider som ikke finnes.
   */
  availableLocales?: readonly string[];
}

const {
  title,
  description,
  type = 'website',
  image,
  imageWidth = 1200,
  imageHeight = 630,
  noindex = false,
  canonical: canonicalOverride,
  availableLocales = LOCALES,
} = Astro.props;

const locale = localeFromPath(Astro.url.pathname);
const meta = LOCALE_META[locale];
const localeMeta = SITE_META[locale];

// Delebildet finnes i én variant per språk, slik at taglinen i bildet er på
// samme språk som siden det deles fra. Sider som sender inn sitt eget bilde
// (kundecase, blogginnlegg) overstyrer dette.
const defaultOgImage = locale === DEFAULT_LOCALE ? site.ogImage : `/og-default-${locale}.png`;
const shareImage = image ?? defaultOgImage;

// Forsiden bruker full tittel; undersider får " | Samsari" bak seg.
const fullTitle = title ? `${title} | ${site.name}` : localeMeta.defaultTitle;
const metaDescription = description ?? localeMeta.defaultDescription;

/** Absolutt URL i samme trailing-slash-format som det genererte sitemapet. */
const absolute = (path: string) => {
  const url = new URL(path, site.url);
  if (!url.pathname.endsWith('/') && !url.pathname.split('/').at(-1)?.includes('.')) {
    url.pathname += '/';
  }
  return url.href;
};

const canonical = canonicalOverride ?? absolute(Astro.url.pathname);

// Den språknøytrale ruten, brukt til å regne ut søskensidene på tvers av språk.
const basePath = stripLocale(Astro.url.pathname);

const alternates = LOCALES.filter((l) => availableLocales.includes(l)).map((l) => ({
  hreflang: LOCALE_META[l].hreflang,
  href: absolute(localizePath(basePath, l)),
}));

const imageUrl = new URL(shareImage, site.url).href;
---

<title>{fullTitle}</title>
<meta name="description" content={metaDescription} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />

{
  /* hreflang: forteller Google at dette er samme side på ulike språk, slik at
     de ikke konkurrerer med hverandre. x-default peker på norsk. Droppes på
     noindex-sider — der finnes det ingenting å knytte sammen. */
  !noindex && (
    <>
      {alternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))}
      <link rel="alternate" hreflang="x-default" href={absolute(localizePath(basePath, DEFAULT_LOCALE))} />
    </>
  )
}

<meta property="og:site_name" content={site.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
{/* Uten dimensjoner må LinkedIn hente bildet før det kan vises, og faller
    ofte tilbake til ingen forhåndsvisning ved aller første deling. */}
<meta property="og:image:width" content={String(imageWidth)} />
<meta property="og:image:height" content={String(imageHeight)} />
<meta property="og:image:alt" content={fullTitle} />
<meta property="og:locale" content={meta.ogLocale} />
{
  LOCALES.filter((l) => l !== locale && availableLocales.includes(l)).map((l) => (
    <meta property="og:locale:alternate" content={LOCALE_META[l].ogLocale} />
  ))
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={fullTitle} />
