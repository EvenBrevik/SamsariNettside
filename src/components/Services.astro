---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import servicesImage from '../assets/services-spisskompetanse.jpg';
import { localeFromPath, localizePath } from '../i18n/config';
import { useTranslations } from '../i18n/utils';
import type { UIKeys } from '../i18n/ui/nb';

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);

// SVG-innholdet er rå markup (ikke JSX) fordi frontmatter-blokken ikke støtter
// JSX-fragmenter — det gjør derimot malen under, via set:html.
interface Pillar {
  titleKey: UIKeys;
  bodyKey: UIKeys;
  icon: string;
  /** Markerer kortet med aksentfargen. Kun AI-kortet bruker den. */
  accent?: boolean;
}

const pillars: readonly Pillar[] = [
  {
    titleKey: 'services.ai.title',
    bodyKey: 'services.ai.body',
    // Lilla markerer AI gjennom hele siden — se .services__card--accent under.
    accent: true,
    icon: `
      <rect x="4" y="4" width="16" height="16" rx="2" ry="2" />
      <rect x="9" y="9" width="6" height="6" />
      <path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3" />
    `,
  },
  {
    titleKey: 'services.training.title',
    bodyKey: 'services.training.body',
    icon: `
      <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
      <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
    `,
  },
  {
    titleKey: 'services.mcp.title',
    bodyKey: 'services.mcp.body',
    icon: `
      <rect x="2" y="2" width="20" height="8" rx="2" ry="2" />
      <rect x="2" y="14" width="20" height="8" rx="2" ry="2" />
      <line x1="6" y1="6" x2="6.01" y2="6" />
      <line x1="6" y1="18" x2="6.01" y2="18" />
    `,
  },
  {
    titleKey: 'services.platform.title',
    bodyKey: 'services.platform.body',
    icon: `
      <rect x="3" y="3" width="7" height="7" />
      <rect x="14" y="3" width="7" height="7" />
      <rect x="14" y="14" width="7" height="7" />
      <rect x="3" y="14" width="7" height="7" />
    `,
  },
];
---

<section class="services" data-services>
  <div class="services__inner">
    <div class="services__intro">
      <div class="services__copy">
        <h2 class="services__title">{t('services.title')}</h2>
        <p class="services__body">{t('services.body')}</p>
        <Button href={localizePath('/tjenester', locale)} variant="secondary">
          {t('services.cta')}
        </Button>
      </div>

      <div class="services__media">
        <span class="services__accent" aria-hidden="true"></span>

        <!-- Originalen er 4417 px bred og 3 MB. Via <Image> konverteres den til
             WebP i flere bredder, slik at nettleseren henter den minste som
             holder for spalten. -->
        <Image
          class="services__photo"
          src={servicesImage}
          alt={t('services.imageAlt')}
          width={840}
          widths={[420, 620, 840, 1120]}
          sizes="(min-width: 56rem) 42vw, (min-width: 40rem) 80vw, 92vw"
          format="webp"
          quality={80}
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <ul class="services__grid">
      {
        pillars.map((pillar, index) => (
          <li class:list={['services__card', pillar.accent && 'services__card--accent']} style={`--i: ${index}`}>
            <span class="services__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={pillar.icon} />
            </span>
            <h3>{t(pillar.titleKey)}</h3>
            <p>{t(pillar.bodyKey)}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Samme inntoning-på-scroll som kundeseksjonen — konsekvent bevegelsesspråk
  // gjennom siden i stedet for at hver seksjon finner opp sin egen.
  const section = document.querySelector<HTMLElement>('[data-services]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (section) {
    if (reduceMotion.matches || !('IntersectionObserver' in window)) {
      section.classList.add('is-visible');
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              section.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15 },
      );
      observer.observe(section);
    }
  }
</script>

<style>
  /* Grå duk mellom de hvite nabo-seksjonene (problemer over, referanser under),
     slik at tjenestene løfter seg ut som sitt eget felt. */
  .services {
    background: var(--color-canvas);
  }

  .services__inner {
    max-width: 80rem;
    margin: 0 auto;
    padding: 5rem 1.25rem;
  }

  @media (min-width: 40rem) {
    .services__inner {
      padding: 6rem 2rem;
    }
  }

  /* --- Intro: tekst + bilde --- */

  .services__intro {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 56rem) {
    .services__intro {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
      gap: clamp(3rem, 6vw, 5rem);
    }
  }

  .services__title {
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 700ms ease,
      transform 700ms ease;
  }

  .services.is-visible .services__title {
    opacity: 1;
    transform: translateY(0);
  }

  .services__body {
    max-width: 46ch;
    margin: 1.25rem 0 0;
    color: var(--color-ink-soft);
    font-size: 1.0625rem;
    line-height: 1.75;
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 700ms ease 80ms,
      transform 700ms ease 80ms;
  }

  .services.is-visible .services__body {
    opacity: 1;
    transform: translateY(0);
  }

  .services__copy :global(.btn) {
    margin-top: 2rem;
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 700ms ease 140ms,
      transform 700ms ease 140ms;
  }

  .services.is-visible .services__copy :global(.btn) {
    opacity: 1;
    transform: translateY(0);
  }

  /* --- Bilde-plassholder --- */

  .services__media {
    position: relative;
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 700ms ease 100ms,
      transform 700ms ease 100ms;
  }

  .services.is-visible .services__media {
    opacity: 1;
    transform: translateY(0);
  }

  /* Samme aksentflate-idé som i heroen, men speilvendt — den binder de to
     seksjonene sammen uten at det ene bildet ser ut som en kopi av det andre. */
  .services__accent {
    position: absolute;
    z-index: 0;
    right: -1.25rem;
    top: -1.25rem;
    width: 55%;
    height: 52%;
    border-radius: 5rem 0.5rem 5rem 0.5rem;
    background: var(--color-brand);
    opacity: 0.1;
  }

  /* :global fordi <Image> er en egen komponent — scoped CSS ville lagt på et
     data-attributt som bildet ikke har, og regelen ville aldri truffet. */
  .services__media :global(.services__photo) {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3.4;
    object-fit: cover;
    /* Ansiktet og skissene sitter i øvre del av bildet, så utsnittet forankres
       litt over midten. */
    object-position: 50% 32%;
    /* Samme asymmetriske hjørne som plassholderen hadde. */
    border-radius: 0.5rem 4rem 0.5rem 4rem;
    background: var(--color-canvas);
  }

  /* --- Kortgrid --- */

  .services__grid {
    display: grid;
    gap: 1.25rem;
    margin: 4.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .services__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }
  }

  @media (min-width: 64rem) {
    .services__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .services__card {
    padding: 1.75rem;
    /* Hvit flate mot den grå duken — uten den ville kortene blitt grå på grå
       og bare rammen skilt dem fra bakgrunnen. */
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 0.5rem 2rem 0.5rem 2rem;
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 600ms ease calc(200ms + var(--i) * 90ms),
      transform 600ms ease calc(200ms + var(--i) * 90ms),
      border-color 220ms ease,
      box-shadow 220ms ease,
      transform 220ms ease;
  }

  .services.is-visible .services__card {
    opacity: 1;
    transform: translateY(0);
  }

  .services__card:hover {
    border-color: transparent;
    box-shadow: 0 1px 2px rgb(36 51 59 / 0.05), 0 16px 32px rgb(36 51 59 / 0.08);
    transform: translateY(-3px);
  }

  .services__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 1.25rem;
    border-radius: 0.75rem;
    background: var(--color-brand-soft);
    color: var(--color-brand);
  }

  /* AI-kortet får aksentfargen. Kun ett av fire kort — nok til å peke ut hva
     som er kjernen i tilbudet, uten at fargen blir en andre merkefarge. */
  .services__card--accent .services__icon {
    background: var(--color-accent-soft);
    color: var(--color-accent-deep);
  }

  .services__card--accent:hover {
    box-shadow: 0 1px 2px rgb(91 43 217 / 0.06), 0 16px 32px rgb(91 43 217 / 0.12);
  }

  .services__icon svg {
    width: 1.375rem;
    height: 1.375rem;
  }

  .services__card h3 {
    margin: 0 0 0.5rem;
    color: var(--color-ink);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .services__card p {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  @media (prefers-reduced-motion: reduce) {
    .services__card:hover {
      transform: none;
    }
  }
</style>
