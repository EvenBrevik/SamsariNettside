---
import { localeFromPath } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);

// SVG-innholdet er rå markup (ikke JSX) fordi frontmatter-blokken ikke støtter
// JSX-fragmenter — det gjør derimot malen under, via set:html.
const points = [
  {
    titleKey: 'problems.manual.title',
    bodyKey: 'problems.manual.body',
    // Sirkelpil: den samme oppgaven som går rundt og rundt.
    icon: `
      <path d="M21 12a9 9 0 1 1-3.5-7.1" />
      <polyline points="21 3 21 9 15 9" />
    `,
  },
  {
    titleKey: 'problems.connected.title',
    bodyKey: 'problems.connected.body',
    // Noder bundet sammen med kanter.
    icon: `
      <circle cx="6" cy="6" r="2.5" />
      <circle cx="18" cy="6" r="2.5" />
      <circle cx="12" cy="18" r="2.5" />
      <path d="M8.5 6h7M7.3 8.2l3.5 7.6M16.7 8.2l-3.5 7.6" />
    `,
  },
  {
    titleKey: 'problems.control.title',
    bodyKey: 'problems.control.body',
    // Lag som samles i én stabel.
    icon: `
      <polygon points="12 3 21 8 12 13 3 8" />
      <polyline points="3 13 12 18 21 13" />
      <polyline points="3 17.5 12 22.5 21 17.5" />
    `,
  },
] as const;
---

<section class="problems" data-problems>
  <div class="problems__inner">
    <div class="problems__intro">
      <h2 class="problems__title">{t('problems.title')}</h2>
      <p class="problems__body">{t('problems.body')}</p>
    </div>

    <ul class="problems__grid">
      {
        points.map((point, index) => (
          <li class="problems__card" style={`--i: ${index}`}>
            <span class="problems__icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={point.icon} />
            </span>
            <h3>{t(point.titleKey)}</h3>
            <p>{t(point.bodyKey)}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Samme inntoning-på-scroll som de andre forsideseksjonene.
  const section = document.querySelector<HTMLElement>('[data-problems]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (section) {
    if (reduceMotion.matches || !('IntersectionObserver' in window)) {
      section.classList.add('is-visible');
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              section.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15 },
      );
      observer.observe(section);
    }
  }
</script>

<style>
  .problems {
    background: var(--color-surface);
  }

  .problems__inner {
    max-width: 80rem;
    margin: 0 auto;
    padding: 5rem 1.25rem;
  }

  @media (min-width: 40rem) {
    .problems__inner {
      padding: 6rem 2rem;
    }
  }

  /* --- Intro --- */

  .problems__intro {
    max-width: 44rem;
  }

  .problems__title {
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 700ms ease,
      transform 700ms ease;
  }

  .problems.is-visible .problems__title {
    opacity: 1;
    transform: translateY(0);
  }

  .problems__body {
    margin: 1.25rem 0 0;
    color: var(--color-ink-soft);
    font-size: 1.0625rem;
    line-height: 1.75;
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 700ms ease 80ms,
      transform 700ms ease 80ms;
  }

  .problems.is-visible .problems__body {
    opacity: 1;
    transform: translateY(0);
  }

  /* --- Punktene --- */

  .problems__grid {
    display: grid;
    gap: 2rem;
    margin: 3.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .problems__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem;
    }
  }

  /* Punktene står uten kort-ramme — dette er en lesende seksjon, ikke en
     lenkesamling, og de fire tjenestekortene under skal eie kortformatet. */
  .problems__card {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 600ms ease calc(180ms + var(--i) * 90ms),
      transform 600ms ease calc(180ms + var(--i) * 90ms);
  }

  .problems.is-visible .problems__card {
    opacity: 1;
    transform: translateY(0);
  }

  .problems__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 1rem;
    border-radius: 0.75rem;
    background: var(--color-brand-soft);
    color: var(--color-brand);
  }

  .problems__icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .problems__card h3 {
    margin: 0 0 0.5rem;
    color: var(--color-ink);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .problems__card p {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 0.9375rem;
    line-height: 1.65;
  }
</style>
