---
import Button from './Button.astro';
import { BOOKING_URL } from '../data/site';
import { localeFromPath, localizePath } from '../i18n/config';
import { useTranslations } from '../i18n/utils';
import { urlFor } from '../lib/sanity';
import { getAllCases, cleanMetrics, leadText, truncate, logoSource } from '../lib/cases';

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);

const cases = await getAllCases(locale);
const contactHref = localizePath('/kontakt', locale);
---

<article class="cases">
  <div class="cases__inner">
    <header class="cases__header">
      <h1 class="cases__title">{t('cases.title')}</h1>
      <p class="cases__intro">{t('cases.intro')}</p>
    </header>

    {
      cases.length === 0 ? (
        /* Sanity er utilgjengelig eller ingen caser er publisert. Siden får en
           ærlig melding i stedet for en tom liste. */
        <div class="cases__empty">
          <p>{t('cases.empty')}</p>
          <Button href={contactHref} variant="secondary">
            {t('cases.emptyCta')}
          </Button>
        </div>
      ) : (
        <ul class="cases__list">
          {cases.map((item, index) => {
            const metrics = cleanMetrics(item.metrics);
            // Redaksjonell ingress om den finnes, ellers utledet av innholdet.
            const lead = truncate(leadText(item), 200);
            const href = item.slug ? localizePath(`/kundecase/${item.slug}`, locale) : null;
            const logo = logoSource(item);

            return (
              <li class="case" style={`--i: ${index}`}>
                <article class="case__panel">
                  <div class="case__brand">
                    {logo ? (
                      <img
                        class="case__logo"
                        src={urlFor(logo).width(360).fit('max').auto('format').url()}
                        alt={logo.alt ?? item.company}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span class="case__company-fallback">{item.company}</span>
                    )}
                  </div>

                  <div class="case__content">
                    {item.sector && <span class="case__sector">{item.sector}</span>}

                    <h2 class="case__name">
                      {href ? (
                        <a class="case__link" href={href}>
                          {item.company}
                        </a>
                      ) : (
                        item.company
                      )}
                    </h2>

                    {lead && <p class="case__lead">{lead}</p>}

                    {metrics.length > 0 && (
                      <ul class="case__metrics">
                        {metrics.map((metric) => (
                          <li class="case__metric">{metric}</li>
                        ))}
                      </ul>
                    )}

                    {/* Uten slug finnes ingen underside å peke på ennå. Da vises
                        ingen lenke, i stedet for en som lander på 404. */}
                    {href && (
                      <span class="case__cta">
                        {t('cases.readMore')}
                        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M3 8h10M9 4l4 4-4 4" />
                        </svg>
                      </span>
                    )}
                  </div>
                </article>
              </li>
            );
          })}
        </ul>
      )
    }

    <aside class="cases__cta">
      <h2 class="cases__cta-title">{t('cases.ctaTitle')}</h2>
      <p class="cases__cta-body">{t('cases.ctaBody')}</p>
      <Button href={BOOKING_URL} external>{t('cases.ctaButton')}</Button>
    </aside>
  </div>
</article>

<style>
  .cases {
    position: relative;
    background: var(--color-surface);
    overflow: hidden;
  }

  .cases::before {
    content: '';
    position: absolute;
    top: -18rem;
    right: -12rem;
    width: 40rem;
    height: 40rem;
    border-radius: 50%;
    background: radial-gradient(circle, var(--color-brand-soft) 0%, transparent 70%);
    opacity: 0.7;
    pointer-events: none;
  }

  .cases__inner {
    position: relative;
    max-width: 64rem;
    margin: 0 auto;
    padding: calc(var(--header-height) + 3rem) 1.25rem 5rem;
  }

  @media (min-width: 40rem) {
    .cases__inner {
      padding: calc(var(--header-height) + 4rem) 2rem 6rem;
    }
  }

  /* --- Topp --- */

  .cases__header {
    max-width: 42rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  .cases__title {
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .cases__intro {
    margin: 1.25rem 0 0;
    color: var(--color-ink-soft);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  /* --- Tom tilstand --- */

  .cases__empty {
    max-width: 38rem;
    margin: 3rem 0 0;
    padding: 2.5rem;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem 2.5rem 0.5rem 2.5rem;
    background: var(--color-canvas);
  }

  .cases__empty p {
    margin: 0 0 1.75rem;
    color: var(--color-ink-soft);
    font-size: 1rem;
    line-height: 1.75;
  }

  /* --- Liste --- */

  .cases__list {
    display: grid;
    gap: 1.75rem;
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
  }

  .case__panel {
    position: relative;
    display: grid;
    gap: 2rem;
    padding: 2.25rem 1.75rem;
    border: 1px solid var(--color-line);
    border-radius: 0.5rem 3rem 0.5rem 3rem;
    background-color: #fff;
    overflow: hidden;
    transition:
      border-color 240ms ease,
      box-shadow 240ms ease;
  }

  .case__panel:hover,
  .case__panel:focus-within {
    border-color: transparent;
    box-shadow: 0 2px 8px rgb(36 51 59 / 0.06), 0 22px 48px rgb(36 51 59 / 0.11);
  }

  @media (min-width: 40rem) {
    .case__panel {
      padding: 3rem 2.5rem;
    }
  }

  @media (min-width: 56rem) {
    .case__panel {
      grid-template-columns: minmax(0, 0.32fr) minmax(0, 1fr);
      gap: clamp(2.5rem, 5vw, 4rem);
      align-items: center;
    }
  }

  /* --- Logo --- */

  .case__brand {
    display: flex;
    align-items: center;
  }

  @media (min-width: 56rem) {
    .case__brand {
      justify-content: center;
      padding-right: clamp(2.5rem, 5vw, 4rem);
      border-right: 1px solid var(--color-line);
    }
  }

  .case__logo {
    display: block;
    width: auto;
    max-width: 100%;
    height: 2.25rem;
    object-fit: contain;
    object-position: left center;
  }

  @media (min-width: 56rem) {
    .case__logo {
      height: 2.75rem;
      object-position: center;
    }
  }

  .case__company-fallback {
    color: var(--color-ink);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  /* --- Innhold --- */

  .case__content {
    position: relative;
  }

  .case__sector {
    display: inline-block;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    background: var(--color-brand-soft);
    color: var(--color-brand);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .case__name {
    margin: 0.875rem 0 0;
    color: var(--color-ink);
    font-size: clamp(1.375rem, 2.6vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }

  .case__link {
    color: inherit;
    text-decoration: none;
  }

  /* Hele panelet blir klikkbart, men bare navnet er den faktiske lenken. */
  .case__link::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: -100rem;
  }

  .case__lead {
    margin: 0.875rem 0 0;
    color: var(--color-ink-soft);
    font-size: 1rem;
    line-height: 1.7;
    /* Ingressen kuttes etter tre linjer, slik at kortene i listen holder
       omtrent samme høyde uansett hvor lang teksten i Sanity er. */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .case__metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .case__metric {
    padding: 0.3125rem 0.75rem;
    border-radius: 999px;
    background: var(--color-canvas);
    border: 1px solid var(--color-line);
    color: var(--color-ink-soft);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .case__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 1.5rem;
    color: var(--color-brand);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .case__cta svg {
    width: 1rem;
    height: 1rem;
    transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .case__panel:hover .case__cta svg,
  .case__panel:focus-within .case__cta svg {
    transform: translateX(3px);
  }

  /* --- Avsluttende CTA --- */

  .cases__cta {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-line);
    text-align: center;
  }

  .cases__cta-title {
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(1.375rem, 2.6vw, 1.75rem);
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .cases__cta-body {
    max-width: 42ch;
    margin: 0.875rem auto 1.75rem;
    color: var(--color-ink-soft);
    font-size: 1rem;
    line-height: 1.7;
  }

  @media (prefers-reduced-motion: reduce) {
    .case__panel:hover .case__cta svg {
      transform: none;
    }
  }
</style>
