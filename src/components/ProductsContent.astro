---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import portalShot from '../assets/product-prosjektportalen.png';
import savasShot from '../assets/product-savas.png';
import forgeShot from '../assets/product-forge-engine.png';
import { BOOKING_URL } from '../data/site';
import { localeFromPath, localizePath } from '../i18n/config';
import { useTranslations } from '../i18n/utils';
import type { UIKeys } from '../i18n/ui/nb';

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);

interface Product {
  key: string;
  nameKey: UIKeys;
  taglineKey: UIKeys;
  bodyKey: UIKeys;
  /** Innledning til «passer for»-listen. Savas har ingen. */
  suitsIntroKey?: UIKeys;
  suits?: UIKeys[];
  featuresKey: UIKeys;
  shot: ImageMetadata;
  visitHref: string;
  visitKey: UIKeys;
  /** Aksentfargen brukes på ett produkt, ikke alle — se kommentaren i CSS. */
  accent?: boolean;
}

const products: readonly Product[] = [
  {
    key: 'portal',
    nameKey: 'pr.portal.name',
    taglineKey: 'pr.portal.tagline',
    bodyKey: 'pr.portal.body',
    suitsIntroKey: 'pr.portal.suitsIntro',
    suits: ['pr.portal.s1', 'pr.portal.s2', 'pr.portal.s3', 'pr.portal.s4'],
    featuresKey: 'pr.portal.features',
    shot: portalShot,
    visitHref: 'https://app.samsari.no',
    visitKey: 'pr.portal.cta',
  },
  {
    key: 'forge',
    nameKey: 'pr.forge.name',
    taglineKey: 'pr.forge.tagline',
    bodyKey: 'pr.forge.body',
    suitsIntroKey: 'pr.forge.suitsIntro',
    suits: ['pr.forge.s1', 'pr.forge.s2', 'pr.forge.s3'],
    featuresKey: 'pr.forge.features',
    shot: forgeShot,
    visitHref: 'https://forgeengine.no',
    visitKey: 'pr.forge.cta',
    accent: true,
  },
  {
    key: 'savas',
    nameKey: 'pr.savas.name',
    taglineKey: 'pr.savas.tagline',
    bodyKey: 'pr.savas.body',
    featuresKey: 'pr.savas.features',
    shot: savasShot,
    visitHref: 'https://savas.no',
    visitKey: 'pr.savas.cta',
  },
];

// Funksjonslistene er skrevet som «A · B · C» i ordboken. De splittes her, slik
// at hver funksjon kan bli sin egen chip i stedet for én lang tekstlinje.
function splitFeatures(value: string): string[] {
  return value
    .split('·')
    .map((part) => part.trim())
    .filter(Boolean);
}

const statuses = [
  { nameKey: 'pr.portal.name' as UIKeys, active: true },
  { nameKey: 'pr.forge.name' as UIKeys, active: true },
  { nameKey: 'pr.savas.name' as UIKeys, active: true },
];

const servicesHref = localizePath('/tjenester', locale);
---

<article class="pr">
  <!-- 1. Hero -->
  <section class="pr-hero">
    <div class="pr-hero__inner">
      <div class="pr-hero__copy">
        <h1 class="pr-hero__title">{t('pr.title')}</h1>
        <p class="pr-hero__intro">{t('pr.intro')}</p>
      </div>

      {/* Produktene som en indeks ved siden av teksten. Heroen gjenspeiler
          dermed hva siden faktisk inneholder, i stedet for å vise et bilde som
          ikke sier noe. Hver rad lenker til sin egen seksjon lenger nede. */}
      <nav class="pr-index" aria-label={t('nav.products')}>
        {
          products.map((product, index) => (
            <a class="pr-index__row" href={`#${product.key}`}>
              <span class="pr-index__num" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>

              <span class="pr-index__text">
                <span class="pr-index__name">{t(product.nameKey)}</span>
                <span class="pr-index__tagline">{t(product.taglineKey)}</span>
              </span>

              <svg class="pr-index__arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 12L12 4M6 4h6v6" />
              </svg>
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <!-- 2. Produktene -->
  {
    products.map((product, index) => (
      <section
        class:list={['product', product.accent && 'product--accent']}
        data-reveal
        id={product.key}
      >
        <div class="pr-wrap">
          {/* Annenhver seksjon speilvendes, slik at siden får rytme i stedet
              for tre identiske rader under hverandre. */}
          <div class:list={['product__grid', index % 2 === 1 && 'product__grid--flip']}>
            <div class="product__copy">
              <span class="product__name">{t(product.nameKey)}</span>
              <h2 class="product__tagline">{t(product.taglineKey)}</h2>
              <p class="product__body">{t(product.bodyKey)}</p>

              {product.suits && product.suitsIntroKey && (
                <div class="product__suits">
                  <p class="product__suits-intro">{t(product.suitsIntroKey)}</p>
                  <ul class="product__suits-list">
                    {product.suits.map((item) => (
                      <li>{t(item)}</li>
                    ))}
                  </ul>
                </div>
              )}

              <div class="product__features">
                <p class="product__label">{t('pr.features')}</p>
                <ul class="product__chips">
                  {splitFeatures(t(product.featuresKey)).map((feature) => (
                    <li class="product__chip">{feature}</li>
                  ))}
                </ul>
              </div>

              <div class="product__actions">
                {/* Hvert produkt har sitt eget nettsted — det er der man leser
                    mer, så én lenke holder. */}
                <Button href={product.visitHref} external>
                  {t(product.visitKey)}
                </Button>
              </div>
            </div>

            <div class="product__media">
              <span class="product__accent" aria-hidden="true" />
              <div class="product__frame">
                <Image
                  class="product__shot"
                  src={product.shot}
                  alt=""
                  width={900}
                  widths={[480, 700, 900, 1200]}
                  sizes="(min-width: 60rem) 48vw, 92vw"
                  format="webp"
                  quality={82}
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </div>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <!-- 3. Produkt eller skreddersøm -->
  <section class="pr-choice" data-reveal>
    <div class="pr-wrap">
      <h2 class="pr-head__title pr-head__title--center">{t('pr.choice.title')}</h2>

      <div class="choice">
        <div class="choice__card">
          <span class="choice__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7" />
              <rect x="14" y="3" width="7" height="7" />
              <rect x="14" y="14" width="7" height="7" />
              <rect x="3" y="14" width="7" height="7" />
            </svg>
          </span>
          <h3>{t('pr.choice.productTitle')}</h3>
          <p>{t('pr.choice.productBody')}</p>
        </div>

        <div class="choice__card choice__card--custom">
          <span class="choice__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6" />
              <polyline points="8 6 2 12 8 18" />
              <line x1="13.5" y1="4" x2="10.5" y2="20" />
            </svg>
          </span>
          <h3>{t('pr.choice.customTitle')}</h3>
          <p>{t('pr.choice.customBody')}</p>
        </div>
      </div>

      <div class="pr-choice__cta">
        <Button href={servicesHref} variant="secondary">{t('pr.choice.cta')}</Button>
      </div>
    </div>
  </section>

  <!-- 4. Produktfilosofi + 5. status -->
  <section class="pr-why" data-reveal>
    <div class="pr-wrap">
      <div class="pr-why__grid">
        <div class="pr-why__copy">
          <h2 class="pr-head__title">{t('pr.why.title')}</h2>
          <p class="pr-why__body">{t('pr.why.body')}</p>
        </div>

        <div class="pr-why__status">
          <p class="product__label">{t('pr.status.title')}</p>
          <ul class="status">
            {
              statuses.map((item) => (
                <li class="status__item">
                  <span class="status__name">{t(item.nameKey)}</span>
                  <span class="status__badge">
                    <span class="status__dot" aria-hidden="true" />
                    {t(item.active ? 'pr.status.active' : 'pr.status.building')}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Avsluttende CTA -->
  <section class="pr-final" data-reveal>
    <div class="pr-wrap">
      <div class="pr-final__panel">
        <h2 class="pr-final__title">{t('pr.final.title')}</h2>
        <p class="pr-final__body">{t('pr.final.body')}</p>
        <div class="pr-final__action">
          <Button href={BOOKING_URL} external>{t('pr.final.cta')}</Button>
        </div>
      </div>
    </div>
  </section>
</article>

<script>
  // Samme inntoning-på-scroll som tjenestesiden.
  const sections = document.querySelectorAll<HTMLElement>('[data-reveal]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (reduceMotion.matches || !('IntersectionObserver' in window)) {
    for (const section of sections) section.classList.add('is-visible');
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.08, rootMargin: '0px 0px -40px 0px' },
    );

    for (const section of sections) observer.observe(section);
  }
</script>

<style>
  /* --- Felles --- */

  .pr-wrap {
    max-width: 76rem;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  @media (min-width: 40rem) {
    .pr-wrap {
      padding: 0 2rem;
    }
  }

  .pr > section {
    padding: 5rem 0;
  }

  @media (min-width: 48rem) {
    .pr > section {
      padding: 7rem 0;
    }
  }

  .pr-head__title {
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(1.75rem, 3.6vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .pr-head__title--center {
    max-width: 24ch;
    margin-inline: auto;
    text-align: center;
  }

  /* --- Inntoning --- */

  [data-reveal] .product__copy,
  [data-reveal] .product__media,
  [data-reveal] .pr-head__title,
  [data-reveal] .choice__card,
  [data-reveal] .pr-choice__cta,
  [data-reveal] .pr-why__copy,
  [data-reveal] .pr-why__status,
  [data-reveal] .pr-final__panel {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 640ms ease,
      transform 640ms ease;
  }

  [data-reveal].is-visible .product__copy,
  [data-reveal].is-visible .product__media,
  [data-reveal].is-visible .pr-head__title,
  [data-reveal].is-visible .choice__card,
  [data-reveal].is-visible .pr-choice__cta,
  [data-reveal].is-visible .pr-why__copy,
  [data-reveal].is-visible .pr-why__status,
  [data-reveal].is-visible .pr-final__panel {
    opacity: 1;
    transform: translateY(0);
  }

  [data-reveal].is-visible .product__media,
  [data-reveal].is-visible .choice__card:nth-child(2),
  [data-reveal].is-visible .pr-why__status {
    transition-delay: 140ms;
  }

  [data-reveal].is-visible .pr-choice__cta {
    transition-delay: 260ms;
  }

  /* --- 1. Hero --- */

  /* Fyller skjermen, som de andre heroene, men bygget rundt en indeks i stedet
     for et bilde: teksten til venstre, produktene som klikkbare rader til
     høyre. Mye luft, ingen dekorative flater. */
  .pr-hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100vh;
    min-height: 100dvh;
    background: var(--color-surface);
    overflow: hidden;
    padding: calc(var(--header-height) + 2.5rem) 0 3rem !important;
  }

  /* Ett bredt, svakt skjær i hver merkefarge. Holder flaten fra å bli helt
     hvit uten å legge på synlige elementer. */
  .pr-hero::before,
  .pr-hero::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .pr-hero::before {
    top: -24rem;
    left: -18rem;
    width: 52rem;
    height: 52rem;
    background: radial-gradient(circle, var(--color-brand-soft) 0%, transparent 66%);
    opacity: 0.85;
  }

  .pr-hero::after {
    bottom: -26rem;
    right: -16rem;
    width: 44rem;
    height: 44rem;
    background: radial-gradient(circle, var(--color-accent-soft) 0%, transparent 70%);
    opacity: 0.8;
  }

  .pr-hero__inner {
    position: relative;
    display: grid;
    /* Rikelig luft mellom teksten og indeksen når de stables under hverandre. */
    gap: 4.5rem;
    align-items: center;
    width: 100%;
    max-width: 76rem;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  @media (min-width: 40rem) {
    .pr-hero__inner {
      padding: 0 2rem;
    }
  }

  @media (min-width: 62rem) {
    .pr-hero__inner {
      /* Teksten er smalere enn indeksen — kontrasten mellom de to breddene er
         det som gir overskriften tyngde. */
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
      gap: clamp(4rem, 9vw, 7rem);
    }
  }

  /* Teksten tones inn ved innlasting, forskjøvet. */
  .pr-hero__copy > * {
    opacity: 0;
    transform: translateY(18px);
    animation: pr-hero-in 760ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .pr-hero__copy > *:nth-child(2) {
    animation-delay: 110ms;
  }

  @keyframes pr-hero-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .pr-hero__title {
    max-width: 16ch;
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(2.25rem, 5.2vw, 3.75rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    /* 1.04 var for stramt: underlengdene i g, j og p traff linjen under. */
    line-height: 1.14;
  }

  .pr-hero__intro {
    max-width: 44ch;
    margin: 1.75rem 0 0;
    color: var(--color-ink-soft);
    font-size: clamp(1rem, 1.5vw, 1.1875rem);
    line-height: 1.75;
  }

  /* --- Produktindeks --- */

  .pr-index {
    display: grid;
    /* Linjene mellom radene er den eneste dekoren — det holder flaten rolig. */
    border-top: 1px solid var(--color-line);
  }

  .pr-index__row {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1.75rem 0.5rem 1.75rem 0;
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
    opacity: 0;
    transform: translateY(16px);
    animation: pr-hero-in 760ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @media (min-width: 40rem) {
    .pr-index__row {
      gap: 1.75rem;
      padding: 2.25rem 0.75rem 2.25rem 0;
    }
  }

  .pr-index__row:nth-child(1) {
    animation-delay: 220ms;
  }

  .pr-index__row:nth-child(2) {
    animation-delay: 320ms;
  }

  .pr-index__row:nth-child(3) {
    animation-delay: 420ms;
  }

  /* Flaten som fylles inn fra venstre ved hover. Ligger bak innholdet og
     strekkes ut i marginen, slik at den dekker hele raden. */
  .pr-index__row::before {
    content: '';
    position: absolute;
    inset: 0 -1rem;
    border-radius: 0.5rem;
    background: var(--color-canvas);
    opacity: 0;
    transition: opacity 240ms ease;
  }

  .pr-index__row:hover::before,
  .pr-index__row:focus-visible::before {
    opacity: 1;
  }

  .pr-index__num {
    position: relative;
    color: var(--color-brand);
    opacity: 0.35;
    font-size: 0.8125rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
    transition: opacity 240ms ease;
  }

  .pr-index__row:hover .pr-index__num {
    opacity: 1;
  }

  .pr-index__text {
    position: relative;
    display: grid;
    gap: 0.3125rem;
    min-width: 0;
  }

  .pr-index__name {
    color: var(--color-ink);
    font-size: clamp(1.25rem, 2.4vw, 1.625rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .pr-index__tagline {
    color: var(--color-ink-soft);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .pr-index__arrow {
    position: relative;
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    color: var(--color-muted);
    transition:
      color 240ms ease,
      transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .pr-index__row:hover .pr-index__arrow,
  .pr-index__row:focus-visible .pr-index__arrow {
    color: var(--color-brand);
    transform: translate(3px, -3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .pr-hero__copy > *,
    .pr-index__row {
      opacity: 1;
      transform: none;
      animation: none;
    }

    .pr-index__row:hover .pr-index__arrow {
      transform: none;
    }
  }

  /* --- 2. Produktene --- */

  /* Vekslende duk gir hvert produkt sin egen flate å stå på. */
  .product:nth-of-type(odd) {
    background: var(--color-canvas);
  }

  .product:nth-of-type(even) {
    background: var(--color-surface);
  }

  .product__grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 60rem) {
    .product__grid {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1fr);
      gap: clamp(3rem, 7vw, 5.5rem);
    }

    /* Speilvending: bildet til venstre, teksten til høyre. */
    .product__grid--flip .product__copy {
      order: 2;
    }

    .product__grid--flip .product__media {
      order: 1;
    }
  }

  .product__name {
    display: inline-block;
    padding: 0.3125rem 0.875rem;
    border-radius: 999px;
    background: var(--color-brand-soft);
    color: var(--color-brand);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  /* Forge Engine får aksentfargen — ett av tre produkter, nok til å gi siden
     variasjon uten at lilla blir en andre merkefarge. */
  .product--accent .product__name {
    background: var(--color-accent-soft);
    color: var(--color-accent-deep);
  }

  .product__tagline {
    margin: 1.25rem 0 0;
    color: var(--color-ink);
    font-size: clamp(1.625rem, 3.2vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .product__body {
    max-width: 46ch;
    margin: 1.25rem 0 0;
    color: var(--color-ink-soft);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  /* --- Passer for --- */

  .product__suits {
    margin-top: 2rem;
  }

  .product__suits-intro {
    margin: 0 0 0.75rem;
    color: var(--color-ink);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .product__suits-list {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product__suits-list li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--color-ink-soft);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .product__suits-list li::before {
    content: '';
    position: absolute;
    left: 0.3125rem;
    top: 0.625rem;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--color-brand);
    opacity: 0.5;
  }

  .product--accent .product__suits-list li::before {
    background: var(--color-accent);
  }

  /* --- Funksjoner --- */

  .product__label {
    margin: 0 0 0.75rem;
    color: var(--color-muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .product__features {
    margin-top: 2rem;
  }

  .product__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product__chip {
    padding: 0.3125rem 0.75rem;
    border-radius: 999px;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    color: var(--color-ink-soft);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .product:nth-of-type(even) .product__chip {
    background: var(--color-canvas);
  }

  .product__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 2.5rem;
  }

  /* --- Skjermbilde --- */

  .product__media {
    position: relative;
  }

  .product__accent {
    position: absolute;
    z-index: 0;
    right: -1.5rem;
    top: -1.5rem;
    width: 58%;
    height: 55%;
    border-radius: 5rem 0.5rem 5rem 0.5rem;
    background: var(--color-brand);
    opacity: 0.1;
  }

  .product--accent .product__accent {
    background: var(--color-accent);
  }

  .product__grid--flip .product__accent {
    right: auto;
    left: -1.5rem;
    border-radius: 0.5rem 5rem 0.5rem 5rem;
  }

  .product__frame {
    position: relative;
