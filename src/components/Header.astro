---
import LanguageSwitcher from './LanguageSwitcher.astro';
import { mainNav } from '../data/navigation';
import { localeFromPath, localizePath, stripLocale } from '../i18n/config';
import { useTranslations } from '../i18n/utils';
import { getAllPosts } from '../lib/posts';
import { getAllCases, leadText } from '../lib/cases';

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);

// Sammenlign uten språkprefiks, ellers ville /en/tjenester aldri regnes som aktiv.
const currentPath = stripLocale(Astro.url.pathname).replace(/\/$/, '') || '/';

const links = mainNav.map((item) => ({
  label: t(item.labelKey),
  href: localizePath(item.path, locale),
  // Undersider skal også markere forelderen sin i menyen.
  isActive: currentPath === item.path || currentPath.startsWith(`${item.path}/`),
}));

const homeHref = localizePath('/', locale);

type SearchItem = {
  type: 'page' | 'post' | 'case';
  typeLabel: string;
  title: string;
  description: string;
  href: string;
  searchText: string;
};

const pageItems = [
  { title: t('nav.home'), description: t('hero.body'), path: '/' },
  { title: t('nav.services'), description: t('sv.seoDescription'), path: '/tjenester' },
  { title: t('nav.products'), description: t('pr.seoDescription'), path: '/produkter' },
  { title: t('blog.title'), description: t('blog.intro'), path: '/blogg' },
  { title: t('cases.title'), description: t('cases.intro'), path: '/kundecase' },
  { title: t('nav.about'), description: t('ab.seoDescription'), path: '/om-oss' },
  { title: t('nav.contact'), description: t('ct.seoDescription'), path: '/kontakt' },
  { title: t('design.title'), description: t('design.intro'), path: '/design' },
  { title: t('privacy.title'), description: t('privacy.intro'), path: '/personvern' },
];

const [posts, cases] = await Promise.all([getAllPosts(locale), getAllCases(locale)]);

const searchItems: SearchItem[] = [
  ...pageItems.map((item) => ({
    type: 'page' as const,
    typeLabel: t('search.pages'),
    title: item.title,
    description: item.description,
    href: localizePath(item.path, locale),
    searchText: `${item.title} ${item.description}`.toLocaleLowerCase(locale),
  })),
  ...posts
    .filter((post) => post.slug)
    .map((post) => ({
      type: 'post' as const,
      typeLabel: t('search.posts'),
      title: post.title,
      description: post.excerpt ?? post.category ?? '',
      href: localizePath(`/blogg/${post.slug}`, locale),
      searchText: [post.title, post.excerpt, post.category].filter(Boolean).join(' ').toLocaleLowerCase(locale),
    })),
  ...cases
    .filter((study) => study.slug)
    .map((study) => ({
      type: 'case' as const,
      typeLabel: t('search.cases'),
      title: study.company,
      description: leadText(study) || study.sector || '',
      href: localizePath(`/kundecase/${study.slug}`, locale),
      searchText: [study.company, study.sector, study.intro, study.problem, study.solution, study.result, ...(study.services ?? [])]
        .filter(Boolean)
        .join(' ')
        .toLocaleLowerCase(locale),
    })),
];
---

<header class="site-header" data-header>
  <div class="site-header__inner">
    <a href={homeHref} class="site-header__logo" aria-label={t('nav.toHome')}>
      <img
        src="/samsari-logo-dark.png"
        alt="Samsari"
        width="1583"
        height="294"
        fetchpriority="high"
      />
    </a>

    <nav class="site-header__nav" aria-label={t('nav.home')}>
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={link.isActive ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <div class="site-header__search-wrap" data-search-ui>
        <button
          type="button"
          class="site-header__search"
          aria-label={t('search.open')}
          aria-expanded="false"
          aria-controls="header-search"
          data-search-open
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.5-3.5" />
          </svg>
        </button>

        <form class="site-header__search-panel" id="header-search" role="search" aria-hidden="true" inert data-search-panel>
          <svg class="site-header__search-field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.5-3.5" />
          </svg>

          <label class="site-header__search-label" for="header-search-input">{t('search.label')}</label>
          <input
            class="site-header__search-input"
            id="header-search-input"
            type="search"
            name="q"
            placeholder={t('search.placeholder')}
            autocomplete="off"
            data-search-input
          />

          <button type="button" class="site-header__search-close" aria-label={t('search.close')} data-search-close>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
              <path d="M6 6l12 12M18 6 6 18" />
            </svg>
          </button>
        </form>

        <div class="site-header__search-results" hidden data-search-results aria-live="polite">
          <ul class="site-header__search-list" data-search-list>
            {
              searchItems.map((item) => (
                <li data-search-result data-search-text={item.searchText} data-search-title={item.title.toLocaleLowerCase(locale)} hidden>
                  <a class="site-header__search-result" href={item.href}>
                    <span class:list={['site-header__search-type', `site-header__search-type--${item.type}`]}>
                      {item.typeLabel}
                    </span>
                    <strong>{item.title}</strong>
                    {item.description && <span class="site-header__search-description">{item.description}</span>}
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="site-header__search-empty" hidden data-search-empty>{t('search.noResults')}</p>
        </div>
      </div>

      <LanguageSwitcher />

      <button
        type="button"
        class="site-header__toggle"
        aria-label={t('nav.openMenu')}
        aria-expanded="false"
        aria-controls="hovedmeny"
        data-menu-toggle
        data-close-label={t('nav.closeMenu')}
      >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <!-- Mobilmeny. Ligger utenfor .site-header__inner så den kan gå i full bredde. -->
  <div class="site-header__mobile" id="hovedmeny" hidden data-mobile-menu>
    <nav aria-label={t('nav.home')}>
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={link.isActive ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // Headeren er fast. Skygge og kantlinje kommer først når siden er scrollet,
  // slik at den ligger flatt mot innholdet på toppen og løfter seg over det etterpå.
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  const searchUi = document.querySelector<HTMLElement>('[data-search-ui]');
  const searchOpen = document.querySelector<HTMLButtonElement>('[data-search-open]');
  const searchPanel = document.querySelector<HTMLFormElement>('[data-search-panel]');
  const searchInput = document.querySelector<HTMLInputElement>('[data-search-input]');
  const searchClose = document.querySelector<HTMLButtonElement>('[data-search-close]');
  const searchResults = document.querySelector<HTMLElement>('[data-search-results]');
  const searchList = document.querySelector<HTMLElement>('[data-search-list]');
  const searchEmpty = document.querySelector<HTMLElement>('[data-search-empty]');
  const searchResultItems = Array.from(document.querySelectorAll<HTMLElement>('[data-search-result]'));

  const normalizeSearch = (value: string) =>
    value
      .toLocaleLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .trim();

  const renderSearch = (value: string) => {
    if (!searchResults || !searchList || !searchEmpty) return;

    const query = normalizeSearch(value);
    const terms = query.split(/\s+/).filter(Boolean);

    if (terms.length === 0) {
      searchResults.hidden = true;
      searchEmpty.hidden = true;
      searchResultItems.forEach((item) => (item.hidden = true));
      return;
    }

    const matches = searchResultItems
      .filter((item) => {
        const haystack = normalizeSearch(item.dataset.searchText ?? '');
        return terms.every((term) => haystack.includes(term));
      })
      .sort((a, b) => {
        const aTitle = normalizeSearch(a.dataset.searchTitle ?? '');
        const bTitle = normalizeSearch(b.dataset.searchTitle ?? '');
        const aScore = aTitle === query ? 0 : aTitle.startsWith(query) ? 1 : aTitle.includes(query) ? 2 : 3;
        const bScore = bTitle === query ? 0 : bTitle.startsWith(query) ? 1 : bTitle.includes(query) ? 2 : 3;
        return aScore - bScore;
      })
      .slice(0, 8);

    searchResultItems.forEach((item) => (item.hidden = true));
    matches.forEach((item) => {
      item.hidden = false;
      searchList.append(item);
    });

    searchEmpty.hidden = matches.length > 0;
    searchResults.hidden = false;
  };

  const setSearchOpen = (open: boolean) => {
    if (!header || !searchOpen || !searchPanel) return;

    header.classList.toggle('is-searching', open);
    searchOpen.setAttribute('aria-expanded', String(open));
    searchPanel.setAttribute('aria-hidden', String(!open));
    searchPanel.toggleAttribute('inert', !open);

    if (open) {
      window.requestAnimationFrame(() => searchInput?.focus());
    } else {
      if (searchInput) searchInput.value = '';
      renderSearch('');
      searchOpen.focus();
    }
  };

  searchOpen?.addEventListener('click', () => setSearchOpen(true));
  searchClose?.addEventListener('click', () => setSearchOpen(false));
  searchInput?.addEventListener('input', () => renderSearch(searchInput.value));
  searchInput?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') {
      const firstResult = searchList?.querySelector<HTMLAnchorElement>('li:not([hidden]) a');
      if (firstResult) {
        event.preventDefault();
        firstResult.focus();
      }
    }
  });
  searchPanel?.addEventListener('submit', (event) => event.preventDefault());

  document.addEventListener('pointerdown', (event) => {
    if (header?.classList.contains('is-searching') && !searchUi?.contains(event.target as Node)) {
      setSearchOpen(false);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && header?.classList.contains('is-searching')) {
      setSearchOpen(false);
    }
  });

  if (header) {
    let ticking = false;

    const updateScrollState = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 8);
      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(updateScrollState);
        ticking = true;
      }
    };

    updateScrollState();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  if (toggle && menu) {
    const labels = {
      open: toggle.getAttribute('aria-label') ?? 'Åpne meny',
      // Settes fra data-attributtet under, så teksten følger språket.
      close: toggle.dataset.closeLabel ?? 'Lukk meny',
    };

    const setOpen = (open: boolean) => {
      if (open && header?.classList.contains('is-searching')) setSearchOpen(false);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? labels.close : labels.open);
      menu.hidden = !open;
      header?.classList.toggle('is-open', open);
      // Låser bakgrunnen mens menyen dekker skjermen.
      document.body.style.overflow = open ? 'hidden' : '';
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Escape lukker menyen, og fokus føres tilbake til knappen.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    // Menyen er bare for smale skjermer. Blir vinduet bredt mens den står åpen,
    // må den lukkes — ellers blir body liggende låst uten synlig meny.
    const wide = window.matchMedia('(min-width: 60rem)');
    wide.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 50;
    /* Gjennomsiktig på toppen, så sidens egen bakgrunn går ubrutt opp bak
       headeren. Blir hvit først når siden scrolles og innhold skal passere under.
       Kantlinjen ligger der hele tiden og skifter bare farge, slik at layouten
       ikke hopper når den dukker opp. */
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background-color 240ms ease,
      border-color 240ms ease,
      box-shadow 240ms ease;
  }

  .site-header.is-scrolled {
    background: var(--color-surface);
    border-bottom-color: var(--color-line);
    box-shadow: 0 1px 3px rgb(36 51 59 / 0.04), 0 8px 24px rgb(36 51 59 / 0.04);
  }

  /* Mobilmenyen trenger en ugjennomsiktig flate bak seg selv om headeren
     ellers er gjennomsiktig — ellers ville lenkene ligge oppå innholdet. */
  .site-header.is-open {
    background: var(--color-surface);
  }

  .site-header.is-searching {
    background: var(--color-surface);
    border-bottom-color: var(--color-line);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: var(--header-height);
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  @media (min-width: 40rem) {
    .site-header__inner {
      padding: 0 2rem;
    }
  }

  .site-header__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    border-radius: 4px;
  }

  .site-header__logo img {
    display: block;
    width: auto;
    height: 1.75rem;
  }

  @media (min-width: 40rem) {
    .site-header__logo img {
      height: 2rem;
    }
  }

  /* --- Skrivebordsmeny --- */

  .site-header__nav {
    display: none;
    flex: 1;
    transition: opacity 160ms ease;
  }

  @media (min-width: 60rem) {
    .site-header__nav {
      display: block;
    }
  }

  .site-header__nav ul {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__nav a {
    position: relative;
    display: block;
    padding: 0.5rem 0.875rem;
    color: var(--color-ink-soft);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 180ms ease;
  }

  /* Streken ligger klar på alle valg, flat til null bredde. Hover/klikk drar
     den ut fra venstre i stedet for boksen vi hadde før — ingen flate bak
     teksten, bare denne ene linjen som beveger seg. */
  .site-header__nav a::after {
    content: '';
    position: absolute;
    left: 0.875rem;
    right: 0.875rem;
    bottom: -0.4rem;
    height: 2px;
    border-radius: 2px;
    background: var(--color-brand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Effekten er forbeholdt hover/fokus/klikk. Den aktive siden har sin egen
     faste markering rett under og skal ikke i tillegg reagere på hover. */
  .site-header__nav a:not([aria-current='page']):hover,
  .site-header__nav a:not([aria-current='page']):focus-visible,
  .site-header__nav a:not([aria-current='page']):active {
    color: var(--color-ink);
  }

  .site-header__nav a:not([aria-current='page']):hover::after,
  .site-header__nav a:not([aria-current='page']):focus-visible::after,
  .site-header__nav a:not([aria-current='page']):active::after {
    transform: scaleX(1);
  }

  .site-header__nav a[aria-current='page'] {
    color: var(--color-brand);
  }

  /* Understreken for den aktive siden vokser ut fra midten ved innlasting —
     motsatt bevegelse av hover-streken, så de to aldri kan forveksles. */
  .site-header__nav a[aria-current='page']::after {
    transform-origin: center;
    animation: nav-underline 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes nav-underline {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* --- Handlinger til høyre --- */

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }

  .site-header__search-wrap {
    position: relative;
    z-index: 2;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    transition: width 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-header.is-searching .site-header__search-wrap {
    width: min(23rem, calc(100vw - 7.5rem));
  }

  .site-header__search {
    position: absolute;
    top: 0;
    right: 0;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 0.625rem;
    background: transparent;
    color: var(--color-ink-soft);
    cursor: pointer;
    transition:
      opacity 160ms ease,
      color 180ms ease,
      background-color 180ms ease;
  }

  .site-header__search:hover {
    color: var(--color-brand);
    background: var(--color-brand-soft);
  }

  .site-header__search svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .site-header.is-searching .site-header__search {
    opacity: 0;
    pointer-events: none;
  }

  .site-header__search-panel {
    position: absolute;
    top: 50%;
    right: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    width: 100%;
    height: 2.75rem;
    padding: 0 0.375rem 0 0.875rem;
    border: 1px solid var(--color-line);
    border-radius: 0.625rem;
    background: var(--color-canvas);
    opacity: 0;
    pointer-events: none;
    transform: translate(0.5rem, -50%) scaleX(0.25);
    transform-origin: right center;
    transition:
      opacity 180ms ease,
      transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-header.is-searching .site-header__search-panel {
    opacity: 1;
    pointer-events: auto;
    transform: translate(0, -50%) scaleX(1);
  }

  .site-header__search-results {
    position: absolute;
    top: calc(100% + 0.75rem);
    right: 0;
    width: 100%;
    max-height: min(31rem, calc(100vh - var(--header-height) - 2rem));
    padding: 0.5rem;
    border: 1px solid var(--color-line);
    border-radius: 0.875rem;
    background: var(--color-surface);
    box-shadow: 0 18px 48px rgb(36 51 59 / 0.16);
    overflow-y: auto;
    overscroll-behavior: contain;
    animation: search-results-in 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-header__search-results[hidden],
  .site-header__search-list li[hidden],
  .site-header__search-empty[hidden] {
    display: none;
  }

  @keyframes search-results-in {
    from {
      opacity: 0;
      transform: translateY(-0.375rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .site-header__search-list {
    display: grid;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__search-result {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.25rem 0.625rem;
    padding: 0.875rem;
    border: 1px solid transparent;
    border-radius: 0.625rem;
    color: var(--color-ink);
    text-decoration: none;
    transition:
      border-color 180ms ease,
      background-color 180ms ease;
  }

  .site-header__search-result:hover,
  .site-header__search-result:focus-visible {
    border-color: var(--color-line);
    background: var(--color-canvas);
  }

  .site-header__search-result:focus-visible {
    outline-offset: -2px;
  }

  .site-header__search-type {
    grid-row: 1 / span 2;
    align-self: start;
    min-width: 4.5rem;
    padding: 0.1875rem 0.5rem;
    border-radius: 999px;
    background: var(--color-brand-soft);
    color: var(--color-brand);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.45;
    text-align: center;
  }

  .site-header__search-type--post {
    background: var(--color-accent-soft);
    color: var(--color-accent-deep);
  }

  .site-header__search-type--case {
    background: var(--color-sky-soft);
    color: var(--color-brand-dark);
  }

  .site-header__search-result strong {
    min-width: 0;
    overflow: hidden;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .site-header__search-description {
    display: -webkit-box;
    min-width: 0;
    overflow: hidden;
    color: var(--color-ink-soft);
    font-size: 0.75rem;
    line-height: 1.45;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .site-header__search-empty {
    margin: 0;
    padding: 1.5rem 1rem;
    color: var(--color-muted);
    font-size: 0.875rem;
    text-align: center;
  }

  @media (min-width: 60rem) {
    .site-header.is-searching .site-header__nav {
      visibility: hidden;
      opacity: 0;
    }
  }

  @media (max-width: 59.999rem) {
    .site-header.is-searching .site-header__inner {
      gap: 0;
    }

    .site-header.is-searching .site-header__logo,
    .site-header.is-searching .site-header__actions :global(.lang) {
      display: none;
    }

    .site-header.is-searching .site-header__actions {
      flex: 1;
      justify-content: flex-end;
    }

    .site-header.is-searching .site-header__search-wrap {
      width: min(23rem, calc(100vw - 6.25rem));
    }
  }

  .site-header__search-field-icon {
    width: 1.125rem;
    height: 1.125rem;
    color: var(--color-brand);
  }

  .site-header__search-label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
