---
import Button from './Button.astro';

interface Props {
  title: string;
  body: string;
  image?: string;
  tone?: 'dark' | 'light' | 'blue';
  /** Fyller viewporten under headeren. Uten denne får hero-en en fast minstehøyde. */
  tall?: boolean;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  title,
  body,
  image,
  tone = 'light',
  tall = false,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
} = Astro.props;

const isDark = tone === 'dark';
// Rammen rundt bildet: skallet er synlig som marg på alle fire sider.
// `home-shell` følger scroll-temaet fra mørkt til lyst — selve bildet står urørt.
const shell = isDark ? 'home-shell' : 'bg-white';
const panel = tone === 'dark'
  ? 'bg-[#0a252d] text-white'
  : tone === 'blue'
    ? 'bg-[#e6f5fc] text-ink'
    : 'bg-canvas text-ink';
---

<section class:list={['flex min-h-[calc(100svh-84px)] flex-col px-4 pb-4 sm:px-6 sm:pb-6 lg:px-8 lg:pb-8', shell]}>
  <div
    class:list={[
      'grain relative flex w-full flex-1 items-end overflow-hidden rounded-[1.75rem] sm:rounded-[2.25rem]',
      !tall && 'min-h-[32rem] sm:min-h-[38rem]',
      panel,
    ]}
    style={image ? `background-image: linear-gradient(90deg, rgba(5,31,38,.9) 0%, rgba(5,31,38,.56) 52%, rgba(5,31,38,.25) 100%), url('${image}'); background-size: cover; background-position: center;` : undefined}
  >
    {!image && <div class:list={['tech-grid absolute inset-0', isDark ? 'opacity-10' : 'opacity-65']}></div>}
    {!image && <div class:list={['absolute -top-32 right-[8%] h-[32rem] w-[32rem] rounded-full blur-3xl', tone === 'blue' ? 'bg-accent/18' : isDark ? 'bg-accent/16' : 'bg-accent/10']}></div>}
    <slot name="visual" />
    <div class:list={['relative z-10 w-full min-w-0 p-6 sm:p-9 lg:p-12', !image && 'lg:max-w-[68%]']}>
      <h1 class:list={['max-w-3xl break-words font-medium', tall ? 'text-[clamp(2.05rem,4.6vw,4.5rem)] leading-[1] tracking-[-.05em] sm:leading-[.98]' : 'text-[clamp(1.9rem,4vw,3.75rem)] leading-[1.02] tracking-[-.045em]']}>{title}</h1>
      <p class:list={['mt-5 max-w-xl text-base leading-8', isDark || image ? 'text-white/62' : 'text-muted']}>{body}</p>
      {(primaryLabel && primaryHref) && (
        <div class="mt-7 flex min-w-0 flex-col gap-3 [&>a]:w-full sm:flex-row sm:[&>a]:w-auto">
          <Button href={primaryHref} variant={isDark || image ? 'light' : 'primary'}>{primaryLabel}</Button>
          {(secondaryLabel && secondaryHref) && <Button href={secondaryHref} variant="secondary" class={isDark || image ? '!border-white/20 !bg-transparent !text-white hover:!bg-white/10' : ''}>{secondaryLabel}</Button>}
        </div>
      )}
    </div>
  </div>
</section>
