---
import { urlFor } from '../lib/sanity';

// Bilder inne i «Ekstra innhold». astro-portabletext sender hele blokken som
// `node`, så typen holdes løs her og feltene leses defensivt.
interface Props {
  node: { asset?: { _ref?: string }; alt?: string; caption?: string };
}

const { node } = Astro.props;
const src = node?.asset?._ref
  ? urlFor(node).width(1400).fit('max').auto('format').url()
  : null;
---

{
  src && (
    <figure class="body-image">
      <img src={src} alt={node.alt ?? ''} loading="lazy" decoding="async" />
      {node.caption && <figcaption>{node.caption}</figcaption>}
    </figure>
  )
}

<style>
  .body-image {
    margin: 2rem 0;
  }

  .body-image img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.5rem 2rem 0.5rem 2rem;
    border: 1px solid var(--color-line);
  }

  .body-image figcaption {
    margin-top: 0.75rem;
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }
</style>
