---
import Button from './Button.astro';
import { localeFromPath, localizePath } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);

const products = [
  {
    name: 'Prosjektportalen',
    bodyKey: 'products.portal.body',
    href: 'https://app.samsari.no',
    domain: 'app.samsari.no',
  },
  {
    name: 'Savas',
    bodyKey: 'products.savas.body',
    href: 'https://savas.no',
    domain: 'savas.no',
  },
  {
    name: 'Forge Engine',
    bodyKey: 'products.forge.body',
    href: 'https://forgeengine.no',
    domain: 'forgeengine.no',
  },
] as const;
---

<section class="products" data-products>
  <div class="products__inner">
    <div class="products__intro">
      <h2 class="products__title">{t('products.title')}</h2>
      <p class="products__body">{t('products.body')}</p>
      <Button href={localizePath('/produkter', locale)} variant="secondary">
        {t('products.cta')}
      </Button>
    </div>

    <ul class="products__grid">
      {
        products.map((product, index) => (
          <li class="products__card" style={`--i: ${index}`}>
            <a
              class="products__link"
              href={product.href}
              target="_blank"
              rel="noreferrer"
              aria-label={`${product.name} — ${product.domain}`}
            >
              <span class="products__media">
                <span class="products__accent" aria-hidden="true" />

                <!-- Midlertidig plassholder — bytt ut med et ekte skjermbilde når vi har ett. -->
                <span class="products__placeholder">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                    <circle cx="8.5" cy="8.5" r="1.5" />
                    <polyline points="21 15 16 10 5 21" />
                  </svg>
                  <span>{t('services.imagePlaceholder')}</span>
                </span>
              </span>

              <span class="products__body-wrap">
                <span class="products__name">{product.name}</span>
                <p class="products__desc">{t(product.bodyKey)}</p>
                <span class="products__domain">
                  {product.domain}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    <polyline points="15 3 21 3 21 9" />
                    <line x1="10" y1="14" x2="21" y2="3" />
                  </svg>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Samme inntoning-på-scroll som klient- og tjenesteseksjonen.
  const section = document.querySelector<HTMLElement>('[data-products]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (section) {
    if (reduceMotion.matches || !('IntersectionObserver' in window)) {
      section.classList.add('is-visible');
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              section.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15 },
      );
      observer.observe(section);
    }
  }
</script>

<style>
  .products {
    background: var(--color-canvas);
  }

  .products__inner {
    max-width: 80rem;
    margin: 0 auto;
    padding: 5rem 1.25rem;
  }

  @media (min-width: 40rem) {
    .products__inner {
      padding: 6rem 2rem;
    }
  }

  /* --- Intro --- */

  .products__intro {
    max-width: 40rem;
    margin: 0 auto;
    text-align: center;
  }

  .products__title {
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 700ms ease,
      transform 700ms ease;
  }

  .products.is-visible .products__title {
    opacity: 1;
    transform: translateY(0);
  }

  .products__body {
    margin: 1.25rem 0 0;
    color: var(--color-ink-soft);
    font-size: 1.0625rem;
    line-height: 1.75;
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 700ms ease 80ms,
      transform 700ms ease 80ms;
  }

  .products.is-visible .products__body {
    opacity: 1;
    transform: translateY(0);
  }

  .products__intro :global(.btn) {
    margin-top: 1.75rem;
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 700ms ease 140ms,
      transform 700ms ease 140ms;
  }

  .products.is-visible .products__intro :global(.btn) {
    opacity: 1;
    transform: translateY(0);
  }

  /* --- Kortgrid --- */

  .products__grid {
    display: grid;
    gap: 1.5rem;
    margin: 4rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 56rem) {
    .products__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .products__card {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 600ms ease calc(200ms + var(--i) * 100ms),
      transform 600ms ease calc(200ms + var(--i) * 100ms);
  }

  .products.is-visible .products__card {
    opacity: 1;
    transform: translateY(0);
  }

  .products__link {
    display: block;
    height: 100%;
    border-radius: 0.5rem 2.5rem 0.5rem 2.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    overflow: hidden;
    text-decoration: none;
    transition:
      border-color 220ms ease,
      box-shadow 220ms ease,
      transform 220ms ease;
  }

  .products__link:hover,
  .products__link:focus-visible {
    border-color: transparent;
    box-shadow: 0 1px 2px rgb(36 51 59 / 0.05), 0 20px 40px rgb(36 51 59 / 0.1);
    transform: translateY(-3px);
  }

  /* --- Bilde --- */

  .products__media {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .products__accent {
    position: absolute;
    z-index: 0;
    top: -2rem;
    right: -2rem;
    width: 8rem;
    height: 8rem;
    border-radius: 50%;
    background: var(--color-brand);
    opacity: 0.12;
  }

  .products__placeholder {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    aspect-ratio: 16 / 10;
    background: repeating-linear-gradient(
      -45deg,
      var(--color-canvas),
      var(--color-canvas) 10px,
      var(--color-surface) 10px,
      var(--color-surface) 20px
    );
    color: var(--color-muted);
  }

  .products__placeholder svg {
    width: 2rem;
    height: 2rem;
  }

  .products__placeholder span {
    font-size: 0.8125rem;
    font-weight: 500;
  }

  /* --- Tekst --- */

  .products__body-wrap {
    display: block;
    padding: 1.5rem;
  }

  .products__name {
    display: block;
    color: var(--color-ink);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .products__desc {
    margin: 0.5rem 0 0;
    color: var(--color-ink-soft);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .products__domain {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 1.25rem;
    color: var(--color-brand);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .products__domain svg {
    width: 0.9375rem;
    height: 0.9375rem;
    transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .products__link:hover .products__domain svg,
  .products__link:focus-visible .products__domain svg {
    transform: translate(2px, -2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .products__link:hover {
      transform: none;
    }

    .products__link:hover .products__domain svg {
      transform: none;
    }
  }
</style>
