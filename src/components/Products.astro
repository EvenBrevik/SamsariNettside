---
import Button from './Button.astro';

// Seksjon 3: de ferdige produktene. Tekst og skjermbilder er hentet fra produktenes
// egne sider — `preview` er lastet ned til /public så siden ikke er avhengig av dem.
const products = [
  {
    label: 'Kalkulator for produksjonsbedrifter',
    title: 'Forge Engine',
    body: 'Automatiserer priskalkulasjon for laserskjæring, vannjet og plasma. Kunden laster opp CAD-filer og får prisestimat i sanntid.',
    href: 'https://forgeengine.no',
    cta: 'Se Forge Engine',
    preview: '/forge-engine-preview.webp',
    previewWidth: 1600,
    previewHeight: 822,
  },
  {
    label: 'Prosjektstyring og AI-innsikt',
    title: 'Prosjektportalen',
    body: 'En plattform for prosjektstyring, samarbeid og AI-drevne arbeidsprosesser. Full oversikt, bedre kontroll og raskere gjennomføring.',
    href: 'https://app.samsari.no',
    cta: 'Se Prosjektportalen',
    preview: '/prosjektportalen-preview.webp',
    previewWidth: 1199,
    previewHeight: 629,
  },
];
---

<!-- Alltid lys: seksjonen ligger langt under folden, så den ses aldri i det mørke temaet. -->
<section id="produkter" class="bg-[#f7f9fa] px-5 pb-24 pt-4 text-ink sm:px-7 sm:pb-28 lg:px-9 lg:pb-36">
  <div class="mx-auto max-w-[80rem]">
    <p class="text-xs font-semibold uppercase tracking-[.18em] text-accent">Ferdige produkter</p>
    <h2 class="mt-5 max-w-2xl text-[clamp(1.9rem,3.4vw,3.1rem)] font-medium leading-[1.12] tracking-[-.035em]">
      Klare til å tas i bruk
    </h2>
    <p class="mt-5 max-w-xl text-base leading-7 text-muted">
      To produkter vi har bygget selv. De løser konkrete behov uten at det må settes opp et prosjekt først.
    </p>

    <div class="mt-14 grid gap-5">
      {products.map((product) => (
        <article class="grid items-center gap-10 rounded-2xl border border-ink/7 bg-white p-8 sm:p-10 lg:grid-cols-[minmax(0,.8fr)_minmax(0,1fr)] lg:gap-14 lg:p-12">
          <div>
            <img src="/samsari-logo-dark.png" alt="Samsari" width="140" height="36" class="h-6 w-auto" />
            <p class="mt-8 text-xs font-semibold uppercase tracking-[.18em] text-muted">{product.label}</p>
            <h3 class="mt-3 text-[clamp(1.6rem,2.4vw,2.15rem)] font-semibold tracking-[-.025em]">{product.title}</h3>
            <p class="mt-4 max-w-sm text-[15px] leading-7 text-muted">{product.body}</p>
            <div class="mt-8">
              <Button href={product.href}>{product.cta}</Button>
            </div>
          </div>

          <img
            src={product.preview}
            alt={`Skjermbilde fra ${product.title}`}
            width={product.previewWidth}
            height={product.previewHeight}
            loading="lazy"
            decoding="async"
            class="h-auto w-full rounded-xl border border-ink/7"
          />
        </article>
      ))}
    </div>
  </div>
</section>
