---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import portalShot from '../assets/product-prosjektportalen.png';
import savasShot from '../assets/product-savas.png';
import forgeShot from '../assets/product-forge-engine.png';
import { localeFromPath, localizePath } from '../i18n/config';
import { useTranslations } from '../i18n/utils';

const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);

// Skjermbildene importeres fra src/assets (ikke public), slik at Astro kan
// konvertere dem til WebP i flere bredder ved bygg. De er alle tatt fra toppen
// av hver app, så beskjæringen forankres mot toppen (se CSS-en) — da beholdes
// header og de mest gjenkjennelige elementene i utsnittet.
const products = [
  {
    name: 'Prosjektportalen',
    bodyKey: 'products.portal.body',
    href: 'https://app.samsari.no',
    domain: 'app.samsari.no',
    shot: portalShot,
  },
  {
    name: 'Savas',
    bodyKey: 'products.savas.body',
    href: 'https://savas.no',
    domain: 'savas.no',
    shot: savasShot,
  },
  {
    name: 'Forge Engine',
    bodyKey: 'products.forge.body',
    href: 'https://forgeengine.no',
    domain: 'forgeengine.no',
    shot: forgeShot,
  },
] as const;
---

<section class="products" data-products>
  <div class="products__inner">
    <div class="products__intro">
      <h2 class="products__title">{t('products.title')}</h2>
      <p class="products__body">{t('products.body')}</p>
      <Button href={localizePath('/produkter', locale)} variant="secondary">
        {t('products.cta')}
      </Button>
    </div>

    <ul class="products__grid">
      {
        products.map((product, index) => (
          <li class="products__card" style={`--i: ${index}`}>
            <a
              class="products__link"
              href={product.href}
              target="_blank"
              rel="noreferrer"
              aria-label={`${product.name} — ${product.domain}`}
            >
              <span class="products__media">
                <span class="products__accent" aria-hidden="true" />

                <!-- Skjermbildet er dekorativt: lenken har allerede aria-label
                     med produktnavn og domene, så alt-teksten ville blitt
                     gjentakelse for skjermlesere. -->
                <Image
                  class="products__shot"
                  src={product.shot}
                  alt=""
                  width={640}
                  widths={[360, 480, 640, 860]}
                  sizes="(min-width: 56rem) 30vw, (min-width: 40rem) 46vw, 92vw"
                  format="webp"
                  quality={80}
                  loading="lazy"
                  decoding="async"
                />
              </span>

              <span class="products__body-wrap">
                <span class="products__name">{product.name}</span>
                <p class="products__desc">{t(product.bodyKey)}</p>
                <span class="products__domain">
                  {product.domain}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    <polyline points="15 3 21 3 21 9" />
                    <line x1="10" y1="14" x2="21" y2="3" />
                  </svg>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Samme inntoning-på-scroll som klient- og tjenesteseksjonen.
  const section = document.querySelector<HTMLElement>('[data-products]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (section) {
    if (reduceMotion.matches || !('IntersectionObserver' in window)) {
      section.classList.add('is-visible');
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              section.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15 },
      );
      observer.observe(section);
    }
  }
</script>

<style>
  .products {
    background: var(--color-canvas);
  }

  .products__inner {
    max-width: 80rem;
    margin: 0 auto;
    padding: 5rem 1.25rem;
  }

  @media (min-width: 40rem) {
    .products__inner {
      padding: 6rem 2rem;
    }
  }

  /* --- Intro --- */

  .products__intro {
    max-width: 40rem;
    margin: 0 auto;
    text-align: center;
  }

  .products__title {
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 700ms ease,
      transform 700ms ease;
  }

  .products.is-visible .products__title {
    opacity: 1;
    transform: translateY(0);
  }

  .products__body {
    margin: 1.25rem 0 0;
    color: var(--color-ink-soft);
    font-size: 1.0625rem;
    line-height: 1.75;
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 700ms ease 80ms,
      transform 700ms ease 80ms;
  }

  .products.is-visible .products__body {
    opacity: 1;
    transform: translateY(0);
  }

  .products__intro :global(.btn) {
    margin-top: 1.75rem;
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 700ms ease 140ms,
      transform 700ms ease 140ms;
  }

  .products.is-visible .products__intro :global(.btn) {
    opacity: 1;
    transform: translateY(0);
  }

  /* --- Kortgrid --- */

  .products__grid {
    display: grid;
    gap: 1.5rem;
    margin: 4rem 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 56rem) {
    .products__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .products__card {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 600ms ease calc(200ms + var(--i) * 100ms),
      transform 600ms ease calc(200ms + var(--i) * 100ms);
  }

  .products.is-visible .products__card {
    opacity: 1;
    transform: translateY(0);
  }

  .products__link {
    display: block;
    height: 100%;
    border-radius: 0.5rem 2.5rem 0.5rem 2.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    overflow: hidden;
    text-decoration: none;
    transition:
      border-color 220ms ease,
      box-shadow 220ms ease,
      transform 220ms ease;
  }

  .products__link:hover,
  .products__link:focus-visible {
    border-color: transparent;
    box-shadow: 0 1px 2px rgb(36 51 59 / 0.05), 0 20px 40px rgb(36 51 59 / 0.1);
    transform: translateY(-3px);
  }

  /* --- Bilde --- */

  .products__media {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .products__accent {
    position: absolute;
    z-index: 0;
    top: -2rem;
    right: -2rem;
    width: 8rem;
    height: 8rem;
    border-radius: 50%;
    background: var(--color-brand);
    opacity: 0.12;
  }

  /* :global fordi <Image> er en egen komponent — scoped CSS ville lagt på et
     data-attributt som bildet ikke har, og regelen ville aldri truffet. */
  .products__media :global(.products__shot) {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    /* Felles utsnitt for alle tre, selv om originalene har ulike sideforhold —
       det er det som gjør at kortene leses som én rad og ikke tre ulike. */
    aspect-ratio: 16 / 10;
    object-fit: cover;
    /* Skjermbildene er tatt fra toppen av hver app, så utsnittet forankres der.
       Da beholdes header og de mest gjenkjennelige elementene. */
    object-position: 50% 0;
    background: var(--color-canvas);
    border-bottom: 1px solid var(--color-line);
    /* Litt tilbaketrukket i ro, skarpt ved hover — samme idé som gråtoningen
       på kundelogoene, så bildene ikke overdøver teksten under. */
    filter: saturate(0.92);
    transition:
      filter 260ms ease,
      transform 400ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .products__link:hover :global(.products__shot),
  .products__link:focus-visible :global(.products__shot) {
    filter: saturate(1);
    /* Skalerer fra toppen, slik at forankringen holder seg under zoomen. */
    transform: scale(1.03);
    transform-origin: 50% 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .products__link:hover :global(.products__shot),
    .products__link:focus-visible :global(.products__shot) {
      transform: none;
    }
  }

  /* --- Tekst --- */

  .products__body-wrap {
    display: block;
    padding: 1.5rem;
  }

  .products__name {
    display: block;
    color: var(--color-ink);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .products__desc {
    margin: 0.5rem 0 0;
    color: var(--color-ink-soft);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .products__domain {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 1.25rem;
    color: var(--color-brand);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .products__domain svg {
    width: 0.9375rem;
    height: 0.9375rem;
    transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .products__link:hover .products__domain svg,
  .products__link:focus-visible .products__domain svg {
    transform: translate(2px, -2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .products__link:hover {
      transform: none;
    }

    .products__link:hover .products__domain svg {
      transform: none;
    }
  }
</style>
