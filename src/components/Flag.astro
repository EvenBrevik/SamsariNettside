---
import type { Locale } from '../i18n/config';

interface Props {
  locale: Locale;
  class?: string;
}

const { locale, class: className } = Astro.props;

// Flaggene tegnes som SVG i stedet for emoji. Windows har ingen font som
// tegner flagg-emoji, og faller tilbake til bokstavparet («NO»), så emoji
// ville vært ubrukelig for en stor del av besøkende.
//
// Skandinaviske kors deler geometri: samme korsplassering, ulike farger.
// Rutenettet er 16×12 med den vertikale stangen forskjøvet mot venstre.
const nordicCross = { x: 5, w: 2.6, y: 4.7, h: 2.6 };
---

<svg
  class:list={['flag', className]}
  viewBox="0 0 16 12"
  role="presentation"
  aria-hidden="true"
  focusable="false"
>
  {
    locale === 'nb' && (
      <>
        <rect width="16" height="12" fill="#ba0c2f" />
        <path d={`M0 ${nordicCross.y}h16v${nordicCross.h}H0z M${nordicCross.x} 0h${nordicCross.w}v12h-${nordicCross.w}z`} fill="#fff" />
        <path d="M0 5.35h16v1.3H0z M5.65 0h1.3v12h-1.3z" fill="#00205b" />
      </>
    )
  }
  {
    locale === 'sv' && (
      <>
        <rect width="16" height="12" fill="#006aa7" />
        <path d="M0 5.1h16v1.8H0z M5.35 0h1.8v12h-1.8z" fill="#fecc00" />
      </>
    )
  }
  {
    locale === 'da' && (
      <>
        <rect width="16" height="12" fill="#c8102e" />
        <path d="M0 5.1h16v1.8H0z M5.35 0h1.8v12h-1.8z" fill="#fff" />
      </>
    )
  }
  {
    locale === 'en' && (
      <>
        <rect width="16" height="12" fill="#012169" />
        {/* Diagonalene klippes til flaggflaten, ellers stikker de utenfor. */}
        <clipPath id="uk-clip">
          <rect width="16" height="12" />
        </clipPath>
        <g clip-path="url(#uk-clip)">
          <path d="M0 0l16 12M16 0L0 12" stroke="#fff" stroke-width="2.4" />
          <path d="M0 0l16 12M16 0L0 12" stroke="#c8102e" stroke-width="1.4" />
        </g>
        <path d="M0 4.6h16v2.8H0z M6.6 0h2.8v12H6.6z" fill="#fff" />
        <path d="M0 5.2h16v1.6H0z M7.2 0h1.6v12H7.2z" fill="#c8102e" />
      </>
    )
  }
</svg>

<style>
  .flag {
    display: block;
    width: 1.25rem;
    height: 0.9375rem;
    flex-shrink: 0;
    border-radius: 2px;
    /* Hvite flaggflater forsvinner mot hvit bakgrunn uten en svak kant. */
    box-shadow: inset 0 0 0 1px rgb(36 51 59 / 0.12);
  }
</style>
