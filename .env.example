# Kopier til .env for lokal utvikling. Ekte verdier settes som secrets i Cloudflare:
#   npx wrangler secret put TURNSTILE_SECRET_KEY
#   npx wrangler secret put RESEND_API_KEY

# --- Cloudflare Turnstile ---
# Nøklene under er Cloudflares offisielle testnøkler: de godtar alt og
# skal ALDRI brukes i produksjon. Bytt til dine egne fra Cloudflare-dashboardet.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Resend ---
# Avsenderdomenet må være verifisert i Resend (SPF/DKIM på samsari.no),
# ellers avvises utsendingen.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=oliver@samsari.no
CONTACT_FROM_EMAIL=Samsari nettside <skjema@samsari.no>

# --- Cloudflare Web Analytics (valgfritt) ---
# Token fra Cloudflare-dashboardet. Uten den lastes ingen sporing.
PUBLIC_CF_ANALYTICS_TOKEN=
